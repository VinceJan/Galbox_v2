<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Galbox.Acceptance</RootNamespace>
    <AssemblyName>Galbox.Acceptance</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep the headless acceptance host from pulling Windows App SDK auto-init / MSIX tooling.
         EnableCoreMrtTooling=false mirrors src/Galbox.App/Galbox.App.csproj: without it the
         transitive MrtCore.PriGen.targets tries to load Microsoft.Build.Packaging.Pri.Tasks.dll
         from the SDK folder, which does not exist in a plain dotnet CLI install. -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
  </PropertyGroup>

  <!-- A50 drives the real navigation menu through UI Automation, which lives in
       System.Windows.Automation (UIAutomationClient / UIAutomationTypes). Those assemblies ship in
       the Microsoft.WindowsDesktop.App shared framework, so the headless test host needs a
       framework reference to it.

       Deliberately NOT <UseWPF>true</UseWPF>: that switches the project to the WindowsDesktop SDK
       flavour, which REPLACES the default implicit-using set and breaks the existing checks
       (System.Net.Http, System.IO, ... disappear). A plain FrameworkReference only adds the
       assemblies the compiler can see and leaves the rest of the project untouched. No WPF window
       is ever created, and the shipping application is not affected at all. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Galbox.App\Galbox.App.csproj" />
    <!-- A10 drives ISaveNodeScanService (Galbox.Services) exactly as the shipping container
         registers it. Referencing the assembly here does NOT wire anything into the application:
         the wiring under test is the registration in src/Galbox.App/App.xaml.cs, which this project
         mirrors in AcceptanceContainer. Before that registration exists, A10 resolves null and
         FAILS - which is exactly what it is supposed to do. -->
    <ProjectReference Include="..\..\src\Galbox.Services\Galbox.Services.csproj" />
  </ItemGroup>
</Project>
