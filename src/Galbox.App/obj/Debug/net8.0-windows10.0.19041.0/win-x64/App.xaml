<Application
    x:Class="Galbox.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Theme Colors -->
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#202020"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#1C1C1C"/>

            <!-- Converters registered in Page.Resources, not here -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
