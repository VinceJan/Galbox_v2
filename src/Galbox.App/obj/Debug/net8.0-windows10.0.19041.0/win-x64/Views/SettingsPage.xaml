<Page x:ConnectionId='1'
    x:Class="Galbox.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Galbox.App.Converters"
    xmlns:models="using:Galbox.Data.Entities"
    xmlns:viewmodels="using:Galbox.App.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Register Converters -->
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <converters:EmptyStringToBooleanConverter x:Key="EmptyStringToBooleanConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <!-- Settings Card Style -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>

        <!-- Settings Section Header Style -->
        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>

        <!-- Launch Behavior Converter -->
        <converters:LaunchBehaviorConverter x:Key="LaunchBehaviorConverter"/>
        <converters:ExitBehaviorConverter x:Key="ExitBehaviorConverter"/>
        <converters:AppThemeConverter x:Key="AppThemeConverter"/>
        <converters:AppLanguageConverter x:Key="AppLanguageConverter"/>
        <converters:LibraryViewModeConverter x:Key="LibraryViewModeConverter"/>
        <converters:ScreenshotFormatConverter x:Key="ScreenshotFormatConverter"/>
        <converters:BossKeyModifierConverter x:Key="BossKeyModifierConverter"/>
        <converters:DefaultScrapingSourceConverter x:Key="DefaultScrapingSourceConverter"/>
    </Page.Resources>

    <Grid Padding="24">
        <ScrollViewer>
            <StackPanel Spacing="8" MaxWidth="900" HorizontalAlignment="Center">
                <!-- Page Header -->
                <TextBlock
                    Text="Settings"
                    FontSize="28"
                    FontWeight="Bold"
                    Margin="0,0,0,16"/>

                <!-- Loading Indicator -->
                <ProgressRing x:ConnectionId='2'
                                                                        
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0"
                                                                                                                                   />

                <!-- Error Message -->
                <InfoBar x:ConnectionId='3'
                    Title="Error"
                                                                          
                    Severity="Error"
                                                                                                                                   
                    HorizontalAlignment="Stretch"
                    Margin="0,8,0,0"/>

                <!-- Success Message -->
                <InfoBar x:ConnectionId='4'
                    Title="Success"
                                                                            
                    Severity="Success"
                                                                                                                                     
                    HorizontalAlignment="Stretch"
                    Margin="0,8,0,0"/>

                <!-- Save Button -->
                <Button x:ConnectionId='5'
                                                                    
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE74E;"/>
                        <TextBlock Text="Save Settings"/>
                    </StackPanel>
                </Button>

                <!-- ==================== Scraping Settings ==================== -->
                <TextBlock
                    Text="Scraping Settings"
                    Style="{StaticResource SettingsSectionHeaderStyle}"/>

                <!-- Bangumi Source -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Bangumi" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Enable Bangumi as metadata source"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='56'
                            Grid.Column="1"
                                                                                />
                    </Grid>
                </Border>

                <!-- VNDB Source -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="VNDB" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Enable VNDB as metadata source"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='55'
                            Grid.Column="1"
                                                                             />
                    </Grid>
                </Border>

                <!-- ymgal Source -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ymgal" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Enable ymgal as metadata source"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='54'
                            Grid.Column="1"
                                                                              />
                    </Grid>
                </Border>

                <!-- cngal Source -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="cngal" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Enable cngal as metadata source"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='53'
                            Grid.Column="1"
                                                                              />
                    </Grid>
                </Border>

                <!-- Source Priority -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Source Priority" FontWeight="SemiBold"/>
                        <TextBlock
                            Text="Order of sources to use when scraping (higher priority first)"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ListView x:ConnectionId='48'
                            x:Name="SourcePriorityListView"
                                                                                            
                            SelectionMode="None"
                            Margin="0,8,0,0">
                            <ListView.ItemTemplate>
                                <DataTemplate                                           >
                                    <Grid ColumnSpacing="8" Padding="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:ConnectionId='51'
                                            Grid.Column="0"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                                                       
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Move up">
                                            <FontIcon FontSize="12" Glyph="&#xE74A;"/>
                                        </Button>
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding DisplayName}"
                                            VerticalAlignment="Center"/>
                                        <Button x:ConnectionId='52'
                                            Grid.Column="2"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                                                         
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Move down">
                                            <FontIcon FontSize="12" Glyph="&#xE74B;"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Match Threshold -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Match Threshold" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Auto-accept scraped data when match percentage exceeds threshold"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Slider x:ConnectionId='46'
                                                                                      
                                Minimum="50"
                                Maximum="100"
                                Width="120"
                                StepFrequency="5"/>
                            <TextBlock x:ConnectionId='47'
                                                                                     
                                Width="40"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Auto Scraping -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Auto Scraping" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Automatically scrape metadata when adding new games"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='45'
                            Grid.Column="1"
                                                                                  />
                    </Grid>
                </Border>

                <!-- Bangumi Login -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Bangumi Login" FontWeight="SemiBold"/>
                        <TextBlock
                            Text="Login to Bangumi for better scraping results"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:ConnectionId='43' Content="Login via OAuth"                            />
                            <Button x:ConnectionId='44' Content="Enter API Key"                             />
                        </StackPanel>
                        <TextBlock x:ConnectionId='42'
                                                                                
                            FontSize="12"
                            Foreground="{ThemeResource SystemAccentColor}"
                                                                                                                                            />
                    </StackPanel>
                </Border>

                <!-- ==================== Launch Behavior ==================== -->
                <TextBlock
                    Text="Launch Behavior"
                    Style="{StaticResource SettingsSectionHeaderStyle}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="When Launching a Game" FontWeight="SemiBold"/>
                        <TextBlock
                            Text="Behavior of the application when a game is launched"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:ConnectionId='40'
                                                                                                                                                
                            Width="200"
                            HorizontalAlignment="Left">
                            <ComboBoxItem Content="No Action"/>
                            <ComboBoxItem Content="Minimize"/>
                            <ComboBoxItem Content="Minimize to Tray"/>
                            <ComboBoxItem Content="Exit Application"/>
                        </ComboBox>
                        <!-- Warning for Exit App -->
                        <InfoBar x:ConnectionId='41'
                            Title="Warning"
                                                                                           
                            Severity="Warning"
                                                                                                                                                    
                            Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ==================== Exit Behavior ==================== -->
                <TextBlock
                    Text="Exit Behavior"
                    Style="{StaticResource SettingsSectionHeaderStyle}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="When Game Exits" FontWeight="SemiBold"/>
                        <TextBlock
                            Text="Behavior of the application after a game process exits"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:ConnectionId='39'
                                                                                                                                            
                            Width="200"
                            HorizontalAlignment="Left">
                            <ComboBoxItem Content="Maximize to Desktop"/>
                            <ComboBoxItem Content="Stay in Tray"/>
                            <ComboBoxItem Content="Minimize"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Auto Backup on Exit" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Automatically backup game saves when the game exits"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='38'
                            Grid.Column="1"
                                                                                   />
                    </Grid>
                </Border>

                <!-- ==================== Boss Key Settings ==================== -->
                <TextBlock
                    Text="Boss Key Settings"
                    Style="{StaticResource SettingsSectionHeaderStyle}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Enable Boss Key" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Quickly hide all game windows with a hotkey"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='37'
                            Grid.Column="1"
                                                                                />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Boss Key Combination" FontWeight="SemiBold"/>
                        <TextBlock
                            Text="Set the hotkey combination for boss key"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <!-- Modifier Keys -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <CheckBox x:ConnectionId='33' Content="Ctrl"                                                        />
                            <CheckBox x:ConnectionId='34' Content="Alt"                                                       />
                            <CheckBox x:ConnectionId='35' Content="Shift"                                                         />
                            <CheckBox x:ConnectionId='36' Content="Win"                                                       />
                        </StackPanel>

                        <!-- Key Selection -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <TextBlock Text="Key:" VerticalAlignment="Center"/>
                            <ComboBox x:ConnectionId='32'
                                                                                         
                                Width="80"
                                HorizontalAlignment="Left">
                                <x:String>A</x:String>
                                <x:String>B</x:String>
                                <x:String>C</x:String>
                                <x:String>D</x:String>
                                <x:String>E</x:String>
                                <x:String>F</x:String>
                                <x:String>G</x:String>
                                <x:String>H</x:String>
                                <x:String>I</x:String>
                                <x:String>J</x:String>
                                <x:String>K</x:String>
                                <x:String>L</x:String>
                                <x:String>M</x:String>
                                <x:String>N</x:String>
                                <x:String>O</x:String>
                                <x:String>P</x:String>
                                <x:String>Q</x:String>
                                <x:String>R</x:String>
                                <x:String>S</x:String>
                                <x:String>T</x:String>
                                <x:String>U</x:String>
                                <x:String>V</x:String>
                                <x:String>W</x:String>
                                <x:String>X</x:String>
                                <x:String>Y</x:String>
                                <x:String>Z</x:String>
                                <x:String>Space</x:String>
                                <x:String>Esc</x:String>
                            </ComboBox>
                        </StackPanel>

                        <!-- Current Hotkey Display -->
                        <TextBlock x:ConnectionId='31'
                                                                                 
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemAccentColor}"
                            Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Minimize to Tray" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Minimize the app to system tray when boss key is activated"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='30'
                            Grid.Column="1"
                                                                                          />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Show Notification" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Show a notification when boss key is activated"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='29'
                            Grid.Column="1"
                                                                                          />
                    </Grid>
                </Border>

                <!-- ==================== Save Path Settings ==================== -->
                <TextBlock
                    Text="Save Path Settings"
                    Style="{StaticResource SettingsSectionHeaderStyle}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Use Custom Backup Path" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Use a custom path instead of the default app data folder"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='28'
                            Grid.Column="1"
                                                                                      />
                    </Grid>
                </Border>

                <Border x:ConnectionId='6'
                    Style="{StaticResource SettingsCardStyle}"
                                                                                                                                             >
                    <StackPanel Spacing="8">
                        <TextBlock Text="Backup Storage Path" FontWeight="SemiBold"/>
                        <TextBlock x:ConnectionId='26'
                                                                                    
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"/>
                        <Button x:ConnectionId='27'
                            Content="Select Folder"
                                                           
                            Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Default Backup Path (App Data)" FontWeight="SemiBold"/>
                        <TextBlock x:ConnectionId='24'
                                                                              
                            FontSize="12"
                            Foreground="{ThemeResource SystemAccentColor}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap"/>
                        <Button x:ConnectionId='25'
                            Content="Open Data Folder"
                                                                              
                            Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ==================== Process Monitoring ==================== -->
                <TextBlock
                    Text="Process Monitoring"
                    Style="{StaticResource SettingsSectionHeaderStyle}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Advanced Monitoring" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Enable CPU/memory/GPU tracking for running games"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='23'
                            Grid.Column="1"
                                                                                           />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Auto Screenshot on Exit" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Automatically capture a screenshot when game exits"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='22'
                            Grid.Column="1"
                                                                                       />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Monitoring Interval" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="How often to check process state (in milliseconds)"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBox x:ConnectionId='21'
                                                                                           
                                Width="80"
                                InputScope="Number"/>
                            <TextBlock Text="ms" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Screenshot Format" FontWeight="SemiBold"/>
                        <TextBlock
                            Text="Format for captured screenshots"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:ConnectionId='20'
                                                                                                                                                  
                            Width="100"
                            HorizontalAlignment="Left">
                            <ComboBoxItem Content="PNG"/>
                            <ComboBoxItem Content="JPG"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border x:ConnectionId='7'
                    Style="{StaticResource SettingsCardStyle}"
                                                                                                                                                              >
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="JPG Quality" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Quality level for JPG screenshots (1-100)"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Slider x:ConnectionId='18'
                                                                                  
                                Minimum="1"
                                Maximum="100"
                                Width="100"
                                StepFrequency="5"/>
                            <TextBlock x:ConnectionId='19'
                                                                                 
                                Width="30"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== Appearance ==================== -->
                <TextBlock
                    Text="Appearance"
                    Style="{StaticResource SettingsSectionHeaderStyle}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Theme" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Application color theme"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox x:ConnectionId='17'
                            Grid.Column="1"
                                                                                                                               
                            Width="150">
                            <ComboBoxItem Content="System Default"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Language" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Application display language"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox x:ConnectionId='16'
                            Grid.Column="1"
                                                                                                                                     
                            Width="150">
                            <ComboBoxItem Content="Chinese (Simplified)"/>
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="Japanese"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Library View Mode" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Default view mode for game library"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox x:ConnectionId='15'
                            Grid.Column="1"
                                                                                                                                                
                            Width="150">
                            <ComboBoxItem Content="Grid"/>
                            <ComboBoxItem Content="Table"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- ==================== Library Settings ==================== -->
                <TextBlock
                    Text="Library Settings"
                    Style="{StaticResource SettingsSectionHeaderStyle}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Auto Scan on Startup" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Automatically scan for new games when app starts"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='14'
                            Grid.Column="1"
                                                                                    />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Default Scraping Source" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Primary metadata source for game info"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox x:ConnectionId='13'
                            Grid.Column="1"
                            Width="150"
                                                                                                                                                            >
                            <ComboBoxItem Content="Bangumi"/>
                            <ComboBoxItem Content="VNDB"/>
                            <ComboBoxItem Content="ymgal"/>
                            <ComboBoxItem Content="cngal"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- ==================== About ==================== -->
                <TextBlock
                    Text="About"
                    Style="{StaticResource SettingsSectionHeaderStyle}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Galbox" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:ConnectionId='9'
                                                                                                                                      
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock
                            Text="A game library manager for visual novels and galgames."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:ConnectionId='10'
                                                                                
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:ConnectionId='11'
                                                                              
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button x:ConnectionId='12'
                            Content="View on GitHub"
                                                                          
                            Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Database Info -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Database Location" FontWeight="SemiBold"/>
                        <TextBlock
                            Text="Where game data is stored"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:ConnectionId='8'
                                                                              
                            FontSize="12"
                            Foreground="{ThemeResource SystemAccentColor}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

