<Page x:ConnectionId='1'
    x:Class="Galbox.App.Views.GameDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Galbox.App.Converters"
    xmlns:models="using:Galbox.Data.Entities"
    xmlns:vm="using:Galbox.App.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Register Converters -->
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>
        <converters:PathToImageConverter x:Key="PathToImageConverter"/>
        <converters:ByteSizeConverter x:Key="ByteSizeConverter"/>
        <converters:DurationConverter x:Key="DurationConverter"/>
        <converters:RatingConverter x:Key="RatingConverter"/>
        <converters:CountThresholdToVisibilityConverter x:Key="CountThresholdToVisibilityConverter"/>
        <converters:BooleanToIconConverter x:Key="BooleanToIconConverter"/>
        <converters:EmptyStringToBooleanConverter x:Key="EmptyStringToBooleanConverter"/>

        <!-- Styles -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="TagButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </Page.Resources>

    <!-- Main Grid with Background Image -->
    <Grid x:ConnectionId='2' x:Name="RootGrid">
        <!-- Blurred Background Image -->
        <Image x:ConnectionId='3'
            x:Name="BackgroundImage"
                                                                                                                         
            Stretch="UniformToFill"
            Opacity="0.3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Image.RenderTransform>
                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
            </Image.RenderTransform>
        </Image>

        <!-- Loading Indicator -->
        <ProgressRing x:ConnectionId='4'
                                                                
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
                                                                                                                           />

        <!-- Error Message -->
        <InfoBar x:ConnectionId='5'
            Title="Error"
                                                                  
            Severity="Error"
                                                                                                                           
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16"/>

        <!-- Main Content -->
        <ScrollViewer x:ConnectionId='6'
                                                                                                                                  
            Padding="24">
            <StackPanel Orientation="Vertical" MaxWidth="1200" HorizontalAlignment="Center">

                <!-- Header Section: Cover + Basic Info -->
                <Grid ColumnSpacing="24" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cover Image (Vertical Poster) -->
                    <Border
                        Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="8"
                        Padding="0">
                        <Image x:ConnectionId='43'
                                                                                                                                    
                            Width="200"
                            Height="300"
                            Stretch="UniformToFill"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <!-- Game Info -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top">

                        <!-- Title -->
                        <TextBlock x:ConnectionId='30'
                                                                              
                            FontSize="28"
                            FontWeight="Bold"
                            TextWrapping="Wrap"/>

                        <!-- Developer -->
                        <TextBlock x:ConnectionId='31'
                                                                            
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                                                                               
                            Margin="0,4,0,0"/>

                        <!-- Release Date & Rating -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="16">
                            <TextBlock x:ConnectionId='41'
                                                                                                                                      
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                                                                              />
                            <TextBlock x:ConnectionId='42'
                                                                                                                         
                                FontSize="13"
                                Foreground="{ThemeResource SystemAccentColor}"
                                FontWeight="SemiBold"
                                                                                                                                         />
                        </StackPanel>

                        <!-- Tags -->
                        <StackPanel x:ConnectionId='32'
                            Orientation="Horizontal"
                            Margin="0,12,0,0"
                                                                                                                                          >
                            <ItemsRepeater x:ConnectionId='38'                                                   >
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="4"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate                      >
                                        <Button
                                            Content="{Binding}"
                                            Style="{StaticResource TagButtonStyle}"
                                            Command="{Binding ViewModel.NavigateToTagCommand, ElementName=RootGrid}"
                                            CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- Launch Section -->
                        <Grid ColumnSpacing="8" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Launch Button -->
                            <Button x:ConnectionId='35'
                                Grid.Column="0"
                                Style="{StaticResource AccentButtonStyle}"
                                                                              
                                                                                                                                           >
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE768;"/>
                                        <TextBlock Text="Launch"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <!-- Multi-launch Dropdown -->
                            <DropDownButton x:ConnectionId='36'
                                Grid.Column="1"
                                Content="Alternative"
                                                                                                                                                                                    >
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:ConnectionId='37' Placement="BottomEdgeAlignedRight" x:Name="AlternativeExecutablesMenu"/>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>

                        <!-- Running Status -->
                        <InfoBar x:ConnectionId='33'
                            Title="Game Running"
                            Severity="Informational"
                                                                              
                            Margin="0,8,0,0"/>

                        <!-- Favorite Toggle -->
                        <ToggleButton x:ConnectionId='34'
                                                                                  
                                                                              
                            Margin="0,8,0,0">
                            <ToggleButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE191;"/>
                                    <TextBlock Text="Favorite"/>
                                </StackPanel>
                            </ToggleButton.Content>
                        </ToggleButton>
                    </StackPanel>
                </Grid>

                <!-- Description -->
                <Border x:ConnectionId='7' Style="{StaticResource CardStyle}"                                                                                                                      >
                    <StackPanel>
                        <TextBlock Text="Description" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock x:ConnectionId='29'
                                                                              
                            TextWrapping="Wrap"
                            FontSize="14"
                            MaxHeight="200"/>
                    </StackPanel>
                </Border>

                <!-- Characters Section -->
                <Border x:ConnectionId='8' Style="{StaticResource CardStyle}"                                                                                                                     >
                    <StackPanel>
                        <TextBlock Text="Characters" Style="{StaticResource SectionHeaderStyle}"/>
                        <ItemsRepeater x:ConnectionId='26'
                                                                                    
                            MaxHeight="120">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="12"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="100" Height="120">
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="8">
                                            <Image
                                                Source="{Binding ImagePath, Converter={StaticResource PathToImageConverter}}"
                                                Stretch="UniformToFill"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock
                                            Text="{Binding DisplayName}"
                                            FontSize="12"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,8"
                                            TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <Button x:ConnectionId='27'
                            Content="Show All Characters"
                                                                                 
                                                                                                                                                   
                            Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Play Statistics -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Play Statistics" Style="{StaticResource SectionHeaderStyle}"/>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Play Time -->
                            <TextBlock Grid.Column="0" Grid.Row="0" Text="Play Time:" FontWeight="SemiBold"/>
                            <TextBlock x:ConnectionId='22' Grid.Column="0" Grid.Row="1"                                                          Margin="0,4,0,0"/>

                            <!-- Launch Count -->
                            <TextBlock Grid.Column="1" Grid.Row="0" Text="Launches:" FontWeight="SemiBold"/>
                            <TextBlock x:ConnectionId='23' Grid.Column="1" Grid.Row="1"                                                    Margin="0,4,0,0"/>

                            <!-- Last Session -->
                            <TextBlock Grid.Column="2" Grid.Row="0" Text="Last Session:" FontWeight="SemiBold"/>
                            <TextBlock x:ConnectionId='24'
                                Grid.Column="2"
                                Grid.Row="1"
                                                                                                                                          
                                Margin="0,4,0,0"
                                                                                                                                                  />

                            <!-- Game Size -->
                            <TextBlock Grid.Column="3" Grid.Row="0" Text="Size:" FontWeight="SemiBold"/>
                            <TextBlock x:ConnectionId='25' Grid.Column="3" Grid.Row="1"                                                      Margin="0,4,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Documents Section -->
                <Border x:ConnectionId='9' Style="{StaticResource CardStyle}"                                                                                                                    >
                    <StackPanel>
                        <TextBlock Text="Documents" Style="{StaticResource SectionHeaderStyle}"/>
                        <ItemsRepeater x:ConnectionId='20'                                                        >
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Command="{Binding ViewModel.OpenDocumentCommand, ElementName=RootGrid}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="4">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" FontSize="16" Glyph="&#xE8E5;"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Screenshots Section -->
                <Border x:ConnectionId='10' Style="{StaticResource CardStyle}"                                                                                                                      >
                    <StackPanel>
                        <TextBlock Text="Screenshots" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Main Preview -->
                        <Image
                            Source="{Binding SelectedScreenshot.FilePath, Converter={StaticResource PathToImageConverter}}"
                            MaxHeight="400"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12"
                            Visibility="{Binding SelectedScreenshot, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <!-- Thumbnail Gallery -->
                        <ItemsRepeater x:ConnectionId='18'                                                          >
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Width="80"
                                        Height="60"
                                        Padding="0"
                                        Command="{Binding ViewModel.OpenScreenshotCommand, ElementName=RootGrid}"
                                        CommandParameter="{Binding}"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="4">
                                        <Image
                                            Source="{Binding FilePath, Converter={StaticResource PathToImageConverter}}"
                                            Stretch="UniformToFill"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Media Files Section (Music/Video) -->
                <Border x:ConnectionId='11' Style="{StaticResource CardStyle}"                                                                                                                     >
                    <StackPanel>
                        <TextBlock Text="Media Files" Style="{StaticResource SectionHeaderStyle}"/>
                        <ItemsRepeater x:ConnectionId='16'                                                         >
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Column="0"
                                            Command="{Binding ViewModel.PlayMediaCommand, ElementName=RootGrid}"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="4">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" FontSize="16" Glyph="&#xE8D6;"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedDuration}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Save Backups Section -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Save Backups" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Create Backup Button -->
                        <Button x:ConnectionId='12'
                            Content="Create Backup"
                                                                                
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="0,0,0,12"/>

                        <!-- Backup List -->
                        <ItemsRepeater x:ConnectionId='13'
                                                                                     
                                                                                                                                                 >
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Vertical">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock
                                                Text="{Binding CreatedTime, Converter={StaticResource DateTimeFormatConverter}}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock
                                                Text="{Binding FormattedSize}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <Button
                                            Grid.Column="1"
                                            Content="Restore"
                                            Command="{Binding ViewModel.RestoreSaveBackupCommand, ElementName=RootGrid}"
                                            CommandParameter="{Binding}"
                                            CornerRadius="4"/>

                                        <Button
                                            Grid.Column="2"
                                            Content="Delete"
                                            CornerRadius="4"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- No Backups Message -->
                        <TextBlock x:ConnectionId='14'
                            Text="No save backups available"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                                                                                        />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

