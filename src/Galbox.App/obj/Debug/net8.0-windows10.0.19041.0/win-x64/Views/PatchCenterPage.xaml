<Page x:ConnectionId='1'
    x:Class="Galbox.App.Views.PatchCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Galbox.App.Converters"
    xmlns:models="using:Galbox.Data.Entities"
    xmlns:vm="using:Galbox.App.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Register Converters -->
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter"/>
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <converters:EmptyStringToBooleanConverter x:Key="EmptyStringToBooleanConverter"/>
        <converters:PathToImageConverter x:Key="PathToImageConverter"/>
        <converters:ByteSizeConverter x:Key="ByteSizeConverter"/>
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>

        <!-- Custom Converters -->
        <converters:PatchTypeFilterConverter x:Key="PatchTypeFilterConverter"/>
        <converters:PatchStatusToVisibilityConverter x:Key="PatchStatusToVisibilityConverter"/>
        <converters:PatchTypeToColorConverter x:Key="PatchTypeToColorConverter"/>

        <!-- Styles -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Patch Type Badge Colors -->
        <SolidColorBrush x:Key="TranslationPatchColor" Color="#4CAF50"/>
        <SolidColorBrush x:Key="FixPatchColor" Color="#2196F3"/>
        <SolidColorBrush x:Key="AdultPatchColor" Color="#E91E63"/>
        <SolidColorBrush x:Key="OtherPatchColor" Color="#9E9E9E"/>

        <!-- Patch Details Flyout -->
        <Flyout x:Key="PatchDetailsFlyoutKey"
            Placement="Bottom"
            ShouldConstrainToRootBounds="False">
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="16"
                MinWidth="400"
                MaxWidth="500">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Patch Details"
                        FontSize="18"
                        FontWeight="Bold"/>
                    <TextBlock x:ConnectionId='2'
                                                                                 
                        TextWrapping="Wrap"
                        FontSize="14"/>
                </StackPanel>
            </Border>
        </Flyout>
    </Page.Resources>

    <Grid x:ConnectionId='3' x:Name="RootGrid" Padding="24">
        <!-- Loading Indicator -->
        <ProgressRing x:ConnectionId='4'
                                                                
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
                                                                                                                           />

        <!-- Error Message -->
        <InfoBar x:ConnectionId='5'
            Title="Error"
                                                                  
            Severity="Error"
                                                                                                                           
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16"/>

        <!-- Success Message -->
        <InfoBar x:ConnectionId='6'
            Title="Success"
                                                                    
            Severity="Success"
                                                                                                                             
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16,16,16,48"/>

        <!-- Main Content -->
        <Grid x:ConnectionId='7'
                                                                                                                                  >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBlock
                    Grid.Column="0"
                    Text="Patch Center"
                    FontSize="24"
                    FontWeight="Bold"/>

                <!-- Stats -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="24">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:ConnectionId='20'
                                                                                           
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemAccentColor}"
                            HorizontalAlignment="Center"/>
                        <TextBlock
                            Text="Games Need Patches"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:ConnectionId='19'
                                                                                        
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemAccentColor}"
                            HorizontalAlignment="Center"/>
                        <TextBlock
                            Text="Patches Installed"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Refresh Button -->
                <Button x:ConnectionId='18'
                    Grid.Column="2"
                                                               
                    Width="40"
                    Height="40"
                    Padding="0"
                    ToolTipService.ToolTip="Refresh patches">
                    <FontIcon FontSize="16" Glyph="&#xE72C;"/>
                </Button>
            </Grid>

            <!-- Main Two-Column Layout -->
            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Games List -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Games Header -->
                        <TextBlock
                            Grid.Row="0"
                            Text="Games Needing Patches"
                            Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Search Box -->
                        <TextBox x:ConnectionId='14'
                            Grid.Row="1"
                                                                                                                   
                            PlaceholderText="Search games..."
                            CornerRadius="8"
                            Margin="0,0,0,8"/>

                        <!-- Games List -->
                        <ListView x:ConnectionId='15'
                            Grid.Row="2"
                                                                                                     
                                                                                       
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                                                       >
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Cover Thumbnail -->
                                        <Border
                                            Grid.Column="0"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Width="48"
                                            Height="48">
                                            <Image
                                                Source="{Binding CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                                Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- Game Name -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding DisplayName}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1"/>
                                            <TextBlock
                                                Text="{Binding Developer}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1"
                                                Visibility="{Binding Developer, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty Games State -->
                        <StackPanel x:ConnectionId='16'
                            Grid.Row="2"
                                                                                                                                                               
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon FontSize="48" Glyph="&#xE8FD;" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock
                                Text="No games in library"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"/>
                            <TextBlock
                                Text="Add games to see available patches"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Column: Patches Panel -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Patches Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Selected Game Name -->
                            <TextBlock
                                Grid.Column="0"
                                FontSize="16"
                                FontWeight="SemiBold">
                                <Run Text="Available Patches for"/>
                                <Run Text="{Binding SelectedGame.DisplayName}" Foreground="{ThemeResource SystemAccentColor}"/>
                            </TextBlock>

                            <!-- Patch Type Filter -->
                            <ComboBox x:ConnectionId='13'
                                Grid.Column="2"
                                Header="Patch Type"
                                                                                                                                                    
                                Width="120"
                                HorizontalAlignment="Right">
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="Translation"/>
                                <ComboBoxItem Content="Fix"/>
                                <ComboBoxItem Content="Adult"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>
                        </Grid>

                        <!-- Selected Game Info -->
                        <Border
                            Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,12"
                            Visibility="{Binding SelectedGame, Converter={StaticResource NullToVisibilityConverter}}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Game Cover -->
                                <Border
                                    Grid.Column="0"
                                    CornerRadius="4"
                                    Width="80"
                                    Height="100">
                                    <Image
                                        Source="{Binding SelectedGame.CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                        Stretch="UniformToFill"/>
                                </Border>

                                <!-- Game Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding SelectedGame.DisplayName}"
                                        FontSize="18"
                                        FontWeight="Bold"/>
                                    <TextBlock
                                        Text="{Binding SelectedGame.Developer}"
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Margin="0,4,0,0"/>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Margin="0,4,0,0">
                                        <Run x:ConnectionId='12'                                                             />
                                        <Run Text="patches available"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Navigate to Game Button -->
                                <Button x:ConnectionId='11'
                                    Grid.Column="2"
                                    Content="View Game"
                                                                                      
                                    CommandParameter="{Binding SelectedGame}"
                                    VerticalAlignment="Center"
                                    CornerRadius="8"/>
                            </Grid>
                        </Border>

                        <!-- No Game Selected Message -->
                        <StackPanel
                            Grid.Row="1"
                            Visibility="{Binding SelectedGame, Converter={StaticResource NullToVisibilityConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,0,0,12">
                            <TextBlock
                                Text="Select a game from the list to view available patches"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Patches List -->
                        <ScrollViewer Grid.Row="2" Visibility="{Binding SelectedGame, Converter={StaticResource NullToVisibilityConverter}}">
                            <ItemsRepeater x:ConnectionId='9'
                                                                                             
                                Margin="0,0,0,8">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="12"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="8"
                                            Padding="16">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Patch Type Badge -->
                                                <Border
                                                    Grid.Column="0"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding PatchType, Converter={StaticResource PatchTypeToColorConverter}}">
                                                    <TextBlock
                                                        Text="{Binding PatchTypeDisplay}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="White"/>
                                                </Border>

                                                <!-- Patch Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis"
                                                        MaxLines="1"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="8">
                                                        <TextBlock
                                                            Text="{Binding Version}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Visibility="{Binding Version, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                                        <TextBlock
                                                            Text="{Binding FormattedSize}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock
                                                            Text="{Binding Source}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Visibility="{Binding Source, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                                    </StackPanel>

                                                    <!-- Download Progress (shown when downloading) -->
                                                    <ProgressBar
                                                        Value="{Binding DownloadProgress}"
                                                        Maximum="100"
                                                        Margin="0,8,0,0"
                                                        Visibility="{Binding Status, Converter={StaticResource PatchStatusToVisibilityConverter}}"
                                                        ShowPaused="False"
                                                        ShowError="False"/>
                                                </StackPanel>

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <!-- Download Button -->
                                                    <Button
                                                        Command="{Binding ViewModel.DownloadPatchCommand, ElementName=RootGrid}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding Status, Converter={StaticResource PatchStatusToVisibilityConverter}, ConverterParameter=Available}"
                                                        CornerRadius="8"
                                                        Padding="12,6">
                                                        <Button.Content>
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon FontSize="14" Glyph="&#xE896;"/>
                                                                <TextBlock Text="Download"/>
                                                            </StackPanel>
                                                        </Button.Content>
                                                    </Button>

                                                    <!-- Install Button -->
                                                    <Button
                                                        Command="{Binding ViewModel.InstallPatchCommand, ElementName=RootGrid}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding Status, Converter={StaticResource PatchStatusToVisibilityConverter}, ConverterParameter=Downloaded}"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        CornerRadius="8"
                                                        Padding="12,6">
                                                        <Button.Content>
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon FontSize="14" Glyph="&#xE75C;"/>
                                                                <TextBlock Text="Install"/>
                                                            </StackPanel>
                                                        </Button.Content>
                                                    </Button>

                                                    <!-- Installed Badge -->
                                                    <Border
                                                        Background="{ThemeResource SystemAccentColor}"
                                                        CornerRadius="4"
                                                        Padding="12,6"
                                                        Visibility="{Binding Status, Converter={StaticResource PatchStatusToVisibilityConverter}, ConverterParameter=Installed}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon FontSize="14" Glyph="&#xE73E;" Foreground="White"/>
                                                            <TextBlock Text="Installed" FontWeight="SemiBold" Foreground="White"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Details Button -->
                                                    <Button
                                                        Command="{Binding ViewModel.ShowPatchDetailsCommand, ElementName=RootGrid}"
                                                        CommandParameter="{Binding}"
                                                        CornerRadius="8"
                                                        Padding="12,6"
                                                        Background="Transparent">
                                                        <Button.Content>
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon FontSize="14" Glyph="&#xE946;"/>
                                                                <TextBlock Text="Details"/>
                                                            </StackPanel>
                                                        </Button.Content>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>

                        <!-- No Patches Available -->
                        <StackPanel x:ConnectionId='8'
                            Grid.Row="2"
                                                                                                                                                            
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon FontSize="48" Glyph="&#xE771;" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock
                                Text="No patches available"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"/>
                            <TextBlock
                                Text="This game may not have any patches available"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>

