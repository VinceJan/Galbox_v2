<Page x:ConnectionId='1'
    x:Class="Galbox.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Galbox.App.Converters"
    xmlns:models="using:Galbox.Data.Entities"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Register Converters -->
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter"/>
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <converters:EmptyStringToBooleanConverter x:Key="EmptyStringToBooleanConverter"/>
        <converters:PathToImageConverter x:Key="PathToImageConverter"/>
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>

        <!-- Styles -->
        <Style x:Key="QuickLaunchCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <Style x:Key="GameCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="200"/>
        </Style>

        <Style x:Key="LaunchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <Grid x:ConnectionId='2' x:Name="RootGrid">
        <!-- Loading Indicator -->
        <ProgressRing x:ConnectionId='3'
                                                                
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
                                                                                                                           />

        <!-- Error Message -->
        <InfoBar x:ConnectionId='4'
            Title="Error"
                                                                  
            Severity="Error"
                                                                                                                           
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16"/>

        <!-- Main Content -->
        <ScrollViewer x:ConnectionId='5'
                                                                                                                                  
            Padding="24">
            <StackPanel Orientation="Vertical" MaxWidth="1200" HorizontalAlignment="Center">

                <!-- Page Header -->
                <TextBlock
                    Text="Welcome to Galbox"
                    FontSize="24"
                    FontWeight="Bold"
                    Margin="0,0,0,8"/>

                <TextBlock
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,16">
                    <Run x:ConnectionId='20'                                                       />
                    <Run Text="games in your library"/>
                </TextBlock>

                <!-- Quick Launch Section -->
                <Border
                    Style="{StaticResource QuickLaunchCardStyle}"
                    Visibility="{Binding QuickLaunchGame, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cover Image -->
                        <Border
                            Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Width="120"
                            Height="180">
                            <Image
                                Source="{Binding QuickLaunchGame.CoverImagePath, Mode=OneWay, Converter={StaticResource PathToImageConverter}}"
                                Stretch="UniformToFill"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <!-- Game Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <TextBlock
                                Text="{Binding QuickLaunchGame.DisplayName, Mode=OneWay}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                Text="{Binding QuickLaunchGame.Developer, Mode=OneWay}"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{Binding QuickLaunchGame.Developer, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{Binding QuickLaunchGame.LastSessionTime, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                                <Run Text="Last played: "/>
                                <Run Text="{Binding QuickLaunchGame.LastSessionTime, Mode=OneWay, Converter={StaticResource DateTimeFormatConverter}}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Launch Button -->
                        <Button
                            Grid.Column="2"
                            Command="{Binding NavigateToGameCommand}"
                            CommandParameter="{Binding QuickLaunchGame, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Style="{StaticResource LaunchButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE768;"/>
                                <TextBlock Text="Launch"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Currently Playing Section -->
                <Grid>
                    <TextBlock x:ConnectionId='18'
                        Text="Currently Playing"
                        Style="{StaticResource SectionHeaderStyle}"
                                                                                                                                                       />

                    <HyperlinkButton x:ConnectionId='19'
                        Content="See All"
                        HorizontalAlignment="Right"
                                                                                      
                        Margin="0,16,0,8"
                                                                                                                                                       />
                </Grid>

                <ItemsRepeater x:ConnectionId='6'
                                                                                       
                                                                                                                                                   
                    Margin="0,0,0,16">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="12"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button x:ConnectionId='17'
                                                       
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0">
                                <Border Style="{StaticResource GameCardStyle}">
                                    <Grid>
                                        <Image
                                            Source="{Binding CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                            Stretch="UniformToFill"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                        <Border
                                            Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                                            Opacity="0.8"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="0,0,8,8"
                                            Padding="8,4">
                                            <TextBlock
                                                Text="{Binding DisplayName}"
                                                FontSize="12"
                                                TextWrapping="Wrap"
                                                MaxHeight="40"
                                                TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Favorites Section -->
                <Grid>
                    <TextBlock x:ConnectionId='15'
                        Text="Favorites"
                        Style="{StaticResource SectionHeaderStyle}"
                                                                                                                                               />

                    <HyperlinkButton x:ConnectionId='16'
                        Content="See All"
                        HorizontalAlignment="Right"
                                                                               
                        Margin="0,16,0,8"
                                                                                                                                               />
                </Grid>

                <ItemsRepeater x:ConnectionId='7'
                                                                               
                                                                                                                                           
                    Margin="0,0,0,16">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="12"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button x:ConnectionId='14'
                                                       
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0">
                                <Border Style="{StaticResource GameCardStyle}">
                                    <Grid>
                                        <Image
                                            Source="{Binding CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                            Stretch="UniformToFill"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                        <Border
                                            Background="{ThemeResource SystemAccentColor}"
                                            CornerRadius="4"
                                            Padding="4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="4">
                                            <FontIcon FontSize="12" Glyph="&#xE191;" Foreground="White"/>
                                        </Border>

                                        <Border
                                            Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                                            Opacity="0.8"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="0,0,8,8"
                                            Padding="8,4">
                                            <TextBlock
                                                Text="{Binding DisplayName}"
                                                FontSize="12"
                                                TextWrapping="Wrap"
                                                MaxHeight="40"
                                                TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Recent Games Section -->
                <Grid>
                    <TextBlock x:ConnectionId='12'
                        Text="Recently Played"
                        Style="{StaticResource SectionHeaderStyle}"
                                                                                                                                             />

                    <HyperlinkButton x:ConnectionId='13'
                        Content="See All"
                        HorizontalAlignment="Right"
                                                                             
                        Margin="0,16,0,8"
                                                                                                                                             />
                </Grid>

                <ItemsRepeater x:ConnectionId='8'
                                                                             
                                                                                                                                         
                    Margin="0,0,0,16">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="12"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button x:ConnectionId='11'
                                                       
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0">
                                <Border Style="{StaticResource GameCardStyle}">
                                    <Grid>
                                        <Image
                                            Source="{Binding CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                            Stretch="UniformToFill"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                        <Border
                                            Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                                            Opacity="0.8"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="0,0,8,8"
                                            Padding="8,4">
                                            <TextBlock
                                                Text="{Binding DisplayName}"
                                                FontSize="12"
                                                TextWrapping="Wrap"
                                                MaxHeight="40"
                                                TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Empty State -->
                <StackPanel x:ConnectionId='9'
                                                                                                                                              
                    HorizontalAlignment="Center"
                    Spacing="16"
                    Margin="32">
                    <FontIcon FontSize="48" Glyph="&#xE8FD;" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock
                        Text="No games in your library yet"
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"/>
                    <Button x:ConnectionId='10'
                        Content="Add Games"
                                                                             
                        HorizontalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

