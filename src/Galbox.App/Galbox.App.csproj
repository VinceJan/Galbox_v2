<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Galbox.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Single source of truth for the version shown in the window title (and, from there, in
         the taskbar and Alt-Tab). Keep in sync with SettingsViewModel.AppVersion. -->
    <Version>1.0.0</Version>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      The official MRT Core tooling (GenerateProjectPriFile) needs
      Microsoft.Build.Packaging.Pri.Tasks.dll, which ships with the Visual Studio UWP/Appx
      workload. That workload is not installed on this machine: turning this on fails with
      MSB4062 ("could not load Microsoft.Build.Packaging.Pri.Tasks.dll").
      The target below (GenerateAppResourcePriFile) replaces it by driving the standalone
      MakePri.exe from the Microsoft.Windows.SDK.BuildTools package, which IS available.
    -->
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <!-- Disable auto-generated Main to use custom Program.cs with Bootstrap initialization -->
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!--
    Self-contained publishing and the Windows App SDK bootstrapper are mutually exclusive: the
    bootstrapper locates and loads the *framework package* even though the runtime is already
    shipped next to the executable. Program.cs compiles the bootstrap call out entirely when this
    constant is present. (The same constant name is also emitted by Microsoft.WindowsAppSDK's own
    SelfContained.targets, so the two definitions simply agree.)
  -->
  <PropertyGroup Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
    <DefineConstants>$(DefineConstants);WINDOWSAPPSDK_SELFCONTAINED</DefineConstants>
  </PropertyGroup>

  <!--
    Unpackaged WinUI 3 resource (PRI) generation

    WHY THIS EXISTS
    WinUI 3 resolves its own framework resources - starting with
    "ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml", which is requested during
    Application.Start - through the *application's primary resource map*. For an unpackaged app
    that map is the app's own resources.pri, and it must contain a MERGED copy of the framework
    PRI maps (Microsoft.UI.pri, Microsoft.UI.Xaml.Controls.pri). Lookup of a resource that only
    exists in the neutral framework package fails for an unpackaged process (MRT reports
    0x80073D54 "process has no package identity" and then 0x80070002 file-not-found).

    Without resources.pri the failure surfaces as:

        COMException: Cannot locate resource from
        'ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml'
        thrown from Application.Start -> 0xC000027B (STATUS_STOWED_EXCEPTION) inside
        Microsoft.UI.Xaml.dll, i.e. the process dies before OnLaunched ever runs.

    NOTE: this is NOT a publish-only or Release-only problem. Any configuration that produces an
    output folder (dotnet build included) is affected; it only became visible when the first
    self-contained output was launched.
  -->
  <PropertyGroup>
    <!-- MakePri.exe: prefer the path the Windows App SDK resolved (Microsoft.Windows.SDK.BuildTools). -->
    <MakePriExePath Condition="'$(MakePriExePath)' == ''">$(MakePriExeFullPath)</MakePriExePath>
    <MakePriExePath Condition="'$(MakePriExePath)' == '' and Exists('$(WindowsSDKBuildToolsBinVersionedArchFolder)\makepri.exe')">$(WindowsSDKBuildToolsBinVersionedArchFolder)\makepri.exe</MakePriExePath>

    <!-- Default qualifier language for the generated index. The app ships no localised resources
         of its own, so this only labels the index default and does not affect the framework maps. -->
    <AppPriDefaultLanguage Condition="'$(AppPriDefaultLanguage)' == ''">en-US</AppPriDefaultLanguage>
  </PropertyGroup>

  <!-- Last-resort fallback: the installed Windows SDK itself. Glob expansion is ascending, so the
       last match (highest SDK version) wins. -->
  <ItemGroup>
    <_MakePriSdkCandidate Include="$(MSBuildProgramFiles32)\Windows Kits\10\bin\*\x64\makepri.exe" Condition="'$(MakePriExePath)' == ''" />
  </ItemGroup>
  <PropertyGroup Condition="'$(MakePriExePath)' == ''">
    <MakePriExePath>@(_MakePriSdkCandidate)</MakePriExePath>
  </PropertyGroup>

  <!--
    Paths depend on IntermediateOutputPath/OutDir, which the SDK assigns during its own imports -
    i.e. AFTER this project body. Resolving them here at evaluation time yields empty strings, so
    they are computed in a target that everything else depends on.
  -->
  <Target Name="_ResolveAppPriPaths">
    <PropertyGroup>
      <_AppPriIntermediateDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)','$(IntermediateOutputPath)'))</_AppPriIntermediateDir>
      <_AppPriIntermediateDir Condition="$([System.IO.Path]::IsPathRooted('$(IntermediateOutputPath)'))">$([MSBuild]::NormalizeDirectory('$(IntermediateOutputPath)'))</_AppPriIntermediateDir>
      <_AppPriStagingDir>$(_AppPriIntermediateDir)AppPri\</_AppPriStagingDir>
      <!-- Same path without the trailing separator: avoids the native argv escaping hazard of
           passing a quoted argument that ends in a backslash. -->
      <_AppPriStagingDirArg>$(_AppPriIntermediateDir)AppPri</_AppPriStagingDirArg>
      <_AppPriConfigFile>$(_AppPriIntermediateDir)AppPri.config.xml</_AppPriConfigFile>
      <AppPriOutputFile>$(OutDir)resources.pri</AppPriOutputFile>
    </PropertyGroup>
  </Target>

  <Target Name="_EnsureMakePriTool">
    <Error Condition="'$(MakePriExePath)' == '' or !Exists('$(MakePriExePath)')"
           Text="MakePri.exe was not found. It ships in the Microsoft.Windows.SDK.BuildTools NuGet package (usually pulled in by Microsoft.WindowsAppSDK) and in the Windows SDK under bin\&lt;version&gt;\x64\. Install either, or set MakePriExePath manually." />
    <Message Importance="normal" Text="MakePri tool: $(MakePriExePath)" />
    <Message Importance="normal" Text="App PRI output: $(AppPriOutputFile)" />
  </Target>

  <!--
    Collects what has to go into the app's index:
      * every .xbf the XAML compiler produced for this project (its own pages/windows),
        excluding the framework asset folder that the Windows App SDK payload drops in OutDir;
      * every framework .pri sitting next to the output - these are MERGED into the app index by
        the "type=PRI" indexer, which is what makes the Microsoft.UI.Xaml resource map resolvable
        from the app.
  -->
  <Target Name="_CollectAppPriInputs">
    <ItemGroup>
      <_AppPriXbf Include="$(OutDir)**\*.xbf" Exclude="$(OutDir)Microsoft.UI.Xaml\**\*.xbf;$(OutDir)publish\**\*.xbf;$(PublishDir)**\*.xbf" />
      <!-- Framework PRIs are merged only for the self-contained deployment: that is the case in
           which the framework package is deliberately NOT referenced and the app has to carry the
           Microsoft.UI.Xaml resource map itself. In a framework-dependent build the runtime comes
           from the installed package and supplies its own resources.
           The condition also keeps a framework-dependent build from picking up the .pri files a
           previous self-contained build left behind in the shared output folder. -->
      <_AppPriFrameworkPri Condition="'$(WindowsAppSDKSelfContained)' == 'true'"
                           Include="$(OutDir)*.pri" Exclude="$(OutDir)resources*.pri" />
    </ItemGroup>
  </Target>

  <Target Name="GenerateAppResourcePriFile"
          AfterTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="_EnsureMakePriTool;_ResolveAppPriPaths;_CollectAppPriInputs"
          Inputs="@(_AppPriXbf);@(_AppPriFrameworkPri)"
          Outputs="$(AppPriOutputFile)">

    <!-- Stage in a clean folder so that only app-owned resources and the framework PRIs are
         indexed. Indexing the whole output folder would also pull in the ~470 runtime binaries
         and every localisation satellite. -->
    <RemoveDir Directories="$(_AppPriStagingDir)" />
    <MakeDir Directories="$(_AppPriStagingDir)" />
    <!-- Drop per-language satellites an older build may have produced in the output folder. -->
    <ItemGroup>
      <_StaleAppPriSatellite Include="$(OutDir)resources.language-*.pri" />
    </ItemGroup>
    <Delete Files="@(_StaleAppPriSatellite)" ContinueOnError="true" />
    <Copy SourceFiles="@(_AppPriXbf)"
          DestinationFiles="@(_AppPriXbf->'$(_AppPriStagingDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_AppPriFrameworkPri)"
          DestinationFiles="@(_AppPriFrameworkPri->'$(_AppPriStagingDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />

    <!--
      The index configuration is written out explicitly instead of using
      "makepri createconfig", because the generated default carries

          <packaging><autoResourcePackage qualifier="Language"/>...</packaging>

      which makes MakePri split the index into one satellite file per language
      (resources.pri + ~79 resources.language-XX.pri). Only the main file would then contain
      resources, and every framework string would fall back to the neutral English one - the WinUI
      built-in "Settings" navigation item rendered as "Settings" instead of the user's language.
      Omitting <packaging> keeps a single self-contained index that still carries every language
      qualifier that was merged in from the framework PRIs.
    -->
    <ItemGroup>
      <_AppPriConfigLine Include="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?&gt;" />
      <_AppPriConfigLine Include="&lt;resources targetOsVersion=&quot;10.0.0&quot; majorVersion=&quot;1&quot;&gt;" />
      <_AppPriConfigLine Include="  &lt;index root=&quot;\&quot; startIndexAt=&quot;\&quot;&gt;" />
      <_AppPriConfigLine Include="    &lt;default&gt;" />
      <_AppPriConfigLine Include="      &lt;qualifier name=&quot;Language&quot; value=&quot;$(AppPriDefaultLanguage)&quot;/&gt;" />
      <_AppPriConfigLine Include="      &lt;qualifier name=&quot;Contrast&quot; value=&quot;standard&quot;/&gt;" />
      <_AppPriConfigLine Include="      &lt;qualifier name=&quot;Scale&quot; value=&quot;100&quot;/&gt;" />
      <_AppPriConfigLine Include="      &lt;qualifier name=&quot;HomeRegion&quot; value=&quot;001&quot;/&gt;" />
      <_AppPriConfigLine Include="      &lt;qualifier name=&quot;TargetSize&quot; value=&quot;256&quot;/&gt;" />
      <_AppPriConfigLine Include="      &lt;qualifier name=&quot;LayoutDirection&quot; value=&quot;LTR&quot;/&gt;" />
      <_AppPriConfigLine Include="      &lt;qualifier name=&quot;Theme&quot; value=&quot;dark&quot;/&gt;" />
      <_AppPriConfigLine Include="      &lt;qualifier name=&quot;AlternateForm&quot; value=&quot;&quot;/&gt;" />
      <_AppPriConfigLine Include="      &lt;qualifier name=&quot;DXFeatureLevel&quot; value=&quot;DX9&quot;/&gt;" />
      <_AppPriConfigLine Include="      &lt;qualifier name=&quot;Configuration&quot; value=&quot;&quot;/&gt;" />
      <_AppPriConfigLine Include="      &lt;qualifier name=&quot;DeviceFamily&quot; value=&quot;Universal&quot;/&gt;" />
      <_AppPriConfigLine Include="      &lt;qualifier name=&quot;Custom&quot; value=&quot;&quot;/&gt;" />
      <_AppPriConfigLine Include="    &lt;/default&gt;" />
      <_AppPriConfigLine Include="    &lt;indexer-config type=&quot;folder&quot; foldernameAsQualifier=&quot;true&quot; filenameAsQualifier=&quot;true&quot; qualifierDelimiter=&quot;.&quot;/&gt;" />
      <_AppPriConfigLine Include="    &lt;indexer-config type=&quot;resw&quot; convertDotsToSlashes=&quot;true&quot; initialPath=&quot;&quot;/&gt;" />
      <_AppPriConfigLine Include="    &lt;indexer-config type=&quot;resjson&quot; initialPath=&quot;&quot;/&gt;" />
      <_AppPriConfigLine Include="    &lt;indexer-config type=&quot;PRI&quot;/&gt;" />
      <_AppPriConfigLine Include="  &lt;/index&gt;" />
      <_AppPriConfigLine Include="&lt;/resources&gt;" />
    </ItemGroup>
    <WriteLinesToFile File="$(_AppPriConfigFile)" Lines="@(_AppPriConfigLine)" Overwrite="true" Encoding="UTF-8" />

    <Exec Command="&quot;$(MakePriExePath)&quot; new /pr &quot;$(_AppPriStagingDirArg)&quot; /cf &quot;$(_AppPriConfigFile)&quot; /of &quot;$(AppPriOutputFile)&quot; /o"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          StandardOutputImportance="low" />
    <Error Condition="!Exists('$(AppPriOutputFile)')" Text="MakePri did not produce $(AppPriOutputFile)." />
    <Message Importance="normal" Text="Generated $(AppPriOutputFile) from @(_AppPriXbf->Count()) compiled XAML file(s) merged with @(_AppPriFrameworkPri->Count()) framework PRI file(s)." />
  </Target>

  <!--
    dotnet publish copies the assembly and the declared content/None items, but not files an
    intermediate target drops straight into OutDir: the loose .xbf produced by the XAML compiler,
    nor the resources.pri generated above. Without them the published app is missing its compiled
    XAML and its whole resource map. Carry both over explicitly.
  -->
  <Target Name="_IncludeLooseAppResourcesInPublish"
          AfterTargets="Publish"
          DependsOnTargets="GenerateAppResourcePriFile">
    <ItemGroup>
      <_LooseAppResourceToPublish Include="$(OutDir)**\*.xbf" Exclude="$(OutDir)publish\**\*.xbf;$(PublishDir)**\*.xbf" />
      <_LooseAppResourceToPublish Include="$(OutDir)resources.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_LooseAppResourceToPublish)"
          DestinationFiles="@(_LooseAppResourceToPublish->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="normal" Text="Published @(_LooseAppResourceToPublish->Count()) loose app resource file(s) (.xbf + resources.pri) to $(PublishDir)." />
  </Target>

  <!--
    Size optimisation: the self-contained payload extracted from
    Microsoft.WindowsAppRuntime.1.6.msix contains ~95 localisation satellite folders holding only
    .mui files for Microsoft.ui.xaml.dll and Microsoft.UI.Xaml.Phone.dll (~8.5 MB in total).
    Windows falls back to the neutral (English) messages embedded in the DLLs when a satellite is
    absent, so only the languages this application's audience actually uses are shipped.
    Set GalboxTrimUnusedFrameworkLocales=false to keep all of them.
  -->
  <PropertyGroup>
    <GalboxTrimUnusedFrameworkLocales Condition="'$(GalboxTrimUnusedFrameworkLocales)' == ''">true</GalboxTrimUnusedFrameworkLocales>
  </PropertyGroup>

  <Target Name="_TrimUnusedFrameworkLocales"
          BeforeTargets="AddMicrosoftWindowsAppSDKPayloadFiles"
          Condition="'$(WindowsAppSDKSelfContained)' == 'true' and '$(GalboxTrimUnusedFrameworkLocales)' == 'true'">
    <ItemGroup>
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\**\*.mui"
                                           Exclude="$(MicrosoftWindowsAppSDKMsixContent)\en-us\**\*.mui;$(MicrosoftWindowsAppSDKMsixContent)\en-GB\**\*.mui;$(MicrosoftWindowsAppSDKMsixContent)\zh-CN\**\*.mui;$(MicrosoftWindowsAppSDKMsixContent)\zh-TW\**\*.mui;$(MicrosoftWindowsAppSDKMsixContent)\zh-Hans\**\*.mui;$(MicrosoftWindowsAppSDKMsixContent)\zh-Hant\**\*.mui" />
    </ItemGroup>
    <Message Importance="low" Text="Trimming @(MicrosoftWindowsAppSDKFilesExcluded->Count()) unused framework locale satellite file(s)." />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Galbox.Core\Galbox.Core.csproj" />
    <ProjectReference Include="..\Galbox.Data\Galbox.Data.csproj" />
    <!-- The save-node scan service (parser x data). This is the only reference the application layer
         needs for the "存档节点" feature, and it is what makes that feature reachable from a page. -->
    <ProjectReference Include="..\Galbox.Services\Galbox.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="app.manifest" />
  </ItemGroup>
</Project>
