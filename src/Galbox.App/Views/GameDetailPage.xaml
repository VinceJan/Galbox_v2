<Page
    x:Class="Galbox.App.Views.GameDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Galbox.App.Converters"
    xmlns:models="using:Galbox.Data.Entities"
    xmlns:vm="using:Galbox.App.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Register Converters -->
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>
        <converters:PathToImageConverter x:Key="PathToImageConverter"/>
        <converters:ByteSizeConverter x:Key="ByteSizeConverter"/>
        <converters:DurationConverter x:Key="DurationConverter"/>
        <converters:RatingConverter x:Key="RatingConverter"/>
        <converters:CountThresholdToVisibilityConverter x:Key="CountThresholdToVisibilityConverter"/>
        <converters:BooleanToIconConverter x:Key="BooleanToIconConverter"/>
        <converters:EmptyStringToBooleanConverter x:Key="EmptyStringToBooleanConverter"/>

        <!-- Styles - Local styles only, global styles defined in App.xaml -->
        <Style x:Key="TagButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style x:Key="GameDetailCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,8"/>
        </Style>
    </Page.Resources>

    <!-- Main Grid with Background Image -->
    <Grid x:Name="RootGrid">
        <!-- Blurred Background Image -->
        <Image
            x:Name="BackgroundImage"
            Source="{x:Bind ViewModel.BackgroundImagePath, Mode=OneWay, Converter={StaticResource PathToImageConverter}}"
            Stretch="UniformToFill"
            Opacity="0.3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Image.RenderTransform>
                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
            </Image.RenderTransform>
        </Image>

        <!-- Loading Indicator -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Error Message -->
        <InfoBar
            Title="错误"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource EmptyStringToBooleanConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16"/>

        <!-- Main Content -->
        <ScrollViewer
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
            Padding="24">
            <StackPanel Orientation="Vertical" MaxWidth="1200" HorizontalAlignment="Center">

                <!-- Header Section: Cover + Basic Info -->
                <Grid ColumnSpacing="24" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cover Image (Vertical Poster) - Responsive sizing -->
                    <Border
                        Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="8"
                        Padding="0">
                        <Image
                            Source="{x:Bind ViewModel.CoverImagePath, Mode=OneWay, Converter={StaticResource PathToImageConverter}}"
                            MinWidth="150"
                            MaxWidth="250"
                            MinHeight="200"
                            MaxHeight="350"
                            Stretch="UniformToFill"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <!-- Game Info -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top">

                        <!-- Title -->
                        <TextBlock
                            Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}"
                            FontSize="28"
                            FontWeight="Bold"
                            TextWrapping="Wrap"/>

                        <!-- Developer -->
                        <TextBlock
                            Text="{x:Bind ViewModel.Developer, Mode=OneWay}"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind ViewModel.Developer, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}"
                            Margin="0,4,0,0"/>

                        <!-- Release Date & Rating -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="16">
                            <TextBlock
                                Text="{x:Bind ViewModel.ReleaseDate, Mode=OneWay, Converter={StaticResource DateTimeFormatConverter}}"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind ViewModel.ReleaseDate, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <TextBlock
                                Text="{x:Bind ViewModel.Rating, Mode=OneWay, Converter={StaticResource RatingConverter}}"
                                FontSize="13"
                                Foreground="{ThemeResource SystemAccentColor}"
                                FontWeight="SemiBold"
                                Visibility="{x:Bind ViewModel.Rating, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>

                        <!-- Tags -->
                        <StackPanel
                            Orientation="Horizontal"
                            Margin="0,12,0,0"
                            Visibility="{x:Bind ViewModel.Tags.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="4"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button
                                            Content="{Binding}"
                                            Style="{StaticResource TagButtonStyle}"
                                            Command="{Binding ViewModel.NavigateToTagCommand, ElementName=RootGrid}"
                                            CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- Launch Section -->
                        <Grid ColumnSpacing="8" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Launch Button -->
                            <Button
                                Grid.Column="0"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.LaunchGameCommand}"
                                IsEnabled="{x:Bind ViewModel.IsLaunching, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE768;"/>
                                        <TextBlock Text="启动"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <!-- Multi-launch Dropdown -->
                            <DropDownButton
                                Grid.Column="1"
                                Content="其他方式"
                                Visibility="{x:Bind ViewModel.Executables.Count, Mode=OneWay, Converter={StaticResource CountThresholdToVisibilityConverter}, ConverterParameter=1}">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight" x:Name="AlternativeExecutablesMenu"/>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>

                        <!-- Running Status -->
                        <InfoBar
                            Title="游戏正在运行"
                            Severity="Informational"
                            IsOpen="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                            Margin="0,8,0,0"/>

                        <!-- Favorite Toggle -->
                        <ToggleButton
                            IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                            Margin="0,8,0,0">
                            <ToggleButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE191;"/>
                                    <TextBlock Text="收藏"/>
                                </StackPanel>
                            </ToggleButton.Content>
                        </ToggleButton>
                    </StackPanel>
                </Grid>

                <!-- Description -->
                <Border Style="{StaticResource GameDetailCardStyle}" Visibility="{x:Bind ViewModel.Description, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="简介" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock
                            Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                            TextWrapping="Wrap"
                            FontSize="14"
                            MaxHeight="200"/>
                    </StackPanel>
                </Border>

                <!-- Characters Section -->
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.Characters.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="角色" Style="{StaticResource SectionHeaderStyle}"/>
                        <ItemsRepeater
                            ItemsSource="{x:Bind ViewModel.Characters, Mode=OneWay}"
                            MaxHeight="120">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="12"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="100" Height="120">
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="8">
                                            <Image
                                                Source="{Binding ImagePath, Converter={StaticResource PathToImageConverter}}"
                                                Stretch="UniformToFill"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock
                                            Text="{Binding DisplayName}"
                                            FontSize="12"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,8"
                                            TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <Button
                            Content="显示全部角色"
                            Command="{x:Bind ViewModel.ShowAllCharactersCommand}"
                            Visibility="{x:Bind ViewModel.HasMoreCharacters, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Play Statistics -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="游玩统计" Style="{StaticResource SectionHeaderStyle}"/>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Play Time -->
                            <TextBlock Grid.Column="0" Grid.Row="0" Text="游玩时间：" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="0" Grid.Row="1" Text="{x:Bind ViewModel.FormattedPlayTime, Mode=OneWay}" Margin="0,4,0,0"/>

                            <!-- Launch Count -->
                            <TextBlock Grid.Column="1" Grid.Row="0" Text="启动次数：" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{x:Bind ViewModel.LaunchCount, Mode=OneWay}" Margin="0,4,0,0"/>

                            <!-- Last Session -->
                            <TextBlock Grid.Column="2" Grid.Row="0" Text="最后游玩：" FontWeight="SemiBold"/>
                            <TextBlock
                                Grid.Column="2"
                                Grid.Row="1"
                                Text="{x:Bind ViewModel.LastSessionTime, Mode=OneWay, Converter={StaticResource DateTimeFormatConverter}}"
                                Margin="0,4,0,0"
                                Visibility="{x:Bind ViewModel.LastSessionTime, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"/>

                            <!-- Game Size -->
                            <TextBlock Grid.Column="3" Grid.Row="0" Text="大小：" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Grid.Row="1" Text="{x:Bind ViewModel.FormattedSize, Mode=OneWay}" Margin="0,4,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Documents Section -->
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.Documents.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="文档" Style="{StaticResource SectionHeaderStyle}"/>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Documents, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Command="{Binding ViewModel.OpenDocumentCommand, ElementName=RootGrid}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="4">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" FontSize="16" Glyph="&#xE8E5;"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Screenshots Section -->
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.Screenshots.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="截图" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Main Preview -->
                        <Image
                            Source="{Binding SelectedScreenshot.FilePath, Converter={StaticResource PathToImageConverter}}"
                            MaxHeight="400"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12"
                            Visibility="{Binding SelectedScreenshot, Converter={StaticResource NullToVisibilityConverter}}"/>

                        <!-- Thumbnail Gallery -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Screenshots, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Width="80"
                                        Height="60"
                                        Padding="0"
                                        Command="{Binding ViewModel.OpenScreenshotCommand, ElementName=RootGrid}"
                                        CommandParameter="{Binding}"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="4">
                                        <Image
                                            Source="{Binding FilePath, Converter={StaticResource PathToImageConverter}}"
                                            Stretch="UniformToFill"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Media Files Section (Music/Video) -->
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.MediaFiles.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="媒体文件" Style="{StaticResource SectionHeaderStyle}"/>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.MediaFiles, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Column="0"
                                            Command="{Binding ViewModel.PlayMediaCommand, ElementName=RootGrid}"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="4">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" FontSize="16" Glyph="&#xE8D6;"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedDuration}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Save Backups Section -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="存档备份" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Create Backup Button -->
                        <Button
                            Content="创建备份"
                            Command="{x:Bind ViewModel.CreateSaveBackupCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="0,0,0,12"/>

                        <!-- Backup List -->
                        <ItemsRepeater
                            ItemsSource="{x:Bind ViewModel.SaveBackups, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.SaveBackups.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Vertical">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock
                                                Text="{Binding CreatedTime, Converter={StaticResource DateTimeFormatConverter}}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock
                                                Text="{Binding FormattedSize}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <Button
                                            Grid.Column="1"
                                            Content="恢复"
                                            Command="{Binding ViewModel.RestoreSaveBackupCommand, ElementName=RootGrid}"
                                            CommandParameter="{Binding}"
                                            CornerRadius="4"/>

                                        <Button
                                            Grid.Column="2"
                                            Content="删除"
                                            CornerRadius="4"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- No Backups Message -->
                        <TextBlock
                            Text="暂无存档备份"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind ViewModel.SaveBackups.Count, Mode=OneWay, Converter={StaticResource InverseCountToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>