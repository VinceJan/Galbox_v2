<Page
    x:Class="Galbox.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Galbox.App.Converters"
    xmlns:models="using:Galbox.Data.Entities"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Register Converters -->
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter"/>
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <converters:EmptyStringToBooleanConverter x:Key="EmptyStringToBooleanConverter"/>
        <converters:PathToImageConverter x:Key="PathToImageConverter"/>
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>
        <converters:RatingConverter x:Key="RatingConverter"/>
        <converters:ByteSizeConverter x:Key="ByteSizeConverter"/>
        <converters:StatusFilterConverter x:Key="StatusFilterConverter"/>
        <converters:SortOptionConverter x:Key="SortOptionConverter"/>
        <converters:GameStatusConverter x:Key="GameStatusConverter"/>

        <!-- Styles -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="GameGridCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="220"/>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="PlaceholderText" Value="Search games, developer, characters..."/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- Game Card Template for Grid View - Not used, inline template used instead -->
        <DataTemplate x:Key="GameGridCardTemplate">
            <Grid>
                <Button
                    Click="OnGameItemClick"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <Border Style="{StaticResource GameGridCardStyle}">
                        <Grid>
                            <!-- Cover Image -->
                            <Image
                                Source="{Binding CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                Stretch="UniformToFill"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,40"/>

                            <!-- Favorite Badge -->
                            <Border
                                Background="{ThemeResource SystemAccentColor}"
                                CornerRadius="4"
                                Padding="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="4"
                                Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <FontIcon FontSize="12" Glyph="&#xE191;" Foreground="White"/>
                            </Border>

                            <!-- Game Info Overlay -->
                            <Border
                                Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                                Opacity="0.9"
                                VerticalAlignment="Bottom"
                                CornerRadius="0,0,8,8"
                                Padding="8,8"
                                Height="40">
                                <TextBlock
                                    Text="{Binding DisplayName}"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap"
                                    MaxHeight="28"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Button>

                <!-- Quick Launch Button (shown on hover) -->
                <Button
                    x:Name="QuickLaunchButton"
                    Click="OnQuickLaunchClick"
                    Tag="{Binding}"
                    Background="{ThemeResource SystemAccentColor}"
                    CornerRadius="20"
                    Width="40"
                    Height="40"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <FontIcon FontSize="16" Glyph="&#xE768;" Foreground="White"/>
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <!-- Loading Indicator -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Error Message -->
        <InfoBar
            Title="Error"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource EmptyStringToBooleanConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16"/>

        <!-- Success Message -->
        <InfoBar
            Title="Success"
            Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
            Severity="Success"
            IsOpen="{x:Bind ViewModel.SuccessMessage, Mode=OneWay, Converter={StaticResource EmptyStringToBooleanConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16,16,16,48"/>

        <!-- Main Content -->
        <Grid
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
            Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: Title + View Toggle + Add Button -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBlock
                    Grid.Column="0"
                    Text="Game Library"
                    FontSize="24"
                    FontWeight="Bold"/>

                <!-- Games Count -->
                <TextBlock
                    Grid.Column="1"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">
                    <Run Text="{x:Bind ViewModel.FilteredGamesCount, Mode=OneWay}"/>
                    <Run Text="of"/>
                    <Run Text="{x:Bind ViewModel.TotalGamesCount, Mode=OneWay}"/>
                    <Run Text="games"/>
                </TextBlock>

                <!-- Search Box -->
                <TextBox
                    Grid.Column="2"
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource SearchTextBoxStyle}"
                    HorizontalAlignment="Right"
                    Margin="0,0,16,0"/>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                    <!-- Add Game Button -->
                    <Button
                        Click="OnAddGameClick"
                        Width="40"
                        Height="40"
                        Padding="0"
                        ToolTipService.ToolTip="Add game folder">
                        <FontIcon FontSize="16" Glyph="&#xE710;"/>
                    </Button>

                    <!-- Grid View Toggle -->
                    <ToggleButton
                        IsChecked="{x:Bind ViewModel.IsGridView, Mode=OneWay}"
                        Click="OnToggleViewClick"
                        Width="40"
                        Height="40"
                        Padding="0"
                        ToolTipService.ToolTip="Grid view">
                        <FontIcon FontSize="16" Glyph="&#xE80A;"/>
                    </ToggleButton>

                    <!-- Table View Toggle -->
                    <ToggleButton
                        IsChecked="{x:Bind ViewModel.IsTableView, Mode=OneWay}"
                        Click="OnToggleViewClick"
                        Width="40"
                        Height="40"
                        Padding="0"
                        ToolTipService.ToolTip="Table view">
                        <FontIcon FontSize="16" Glyph="&#xE80C;"/>
                    </ToggleButton>

                    <!-- Refresh Button -->
                    <Button
                        Click="OnRefreshClick"
                        Width="40"
                        Height="40"
                        Padding="0"
                        Margin="8,0,0,0"
                        ToolTipService.ToolTip="Refresh library">
                        <FontIcon FontSize="16" Glyph="&#xE72C;"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Filters Section -->
            <Border
                Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <!-- Status Filter -->
                    <ComboBox
                        Header="Status"
                        SelectedIndex="{x:Bind ViewModel.StatusFilter, Converter={StaticResource StatusFilterConverter}, Mode=TwoWay}"
                        Width="150">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Favorites"/>
                        <ComboBoxItem Content="Playing"/>
                        <ComboBoxItem Content="Completed"/>
                        <ComboBoxItem Content="Never Played"/>
                        <ComboBoxItem Content="Recently Added"/>
                    </ComboBox>

                    <!-- Sort Option -->
                    <ComboBox
                        Header="Sort By"
                        SelectedIndex="{x:Bind ViewModel.SortOption, Converter={StaticResource SortOptionConverter}, Mode=TwoWay}"
                        Width="150">
                        <ComboBoxItem Content="Added (Newest)"/>
                        <ComboBoxItem Content="Added (Oldest)"/>
                        <ComboBoxItem Content="Name (A-Z)"/>
                        <ComboBoxItem Content="Name (Z-A)"/>
                        <ComboBoxItem Content="Release Date"/>
                        <ComboBoxItem Content="Play Time"/>
                        <ComboBoxItem Content="Last Played"/>
                        <ComboBoxItem Content="Rating"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Games List (Grid View) -->
            <ScrollViewer Grid.Row="2" Visibility="{x:Bind ViewModel.IsGridView, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsRepeater
                    x:Name="GamesGridRepeater"
                    ItemsSource="{x:Bind ViewModel.FilteredGames, Mode=OneWay}"
                    Margin="0,0,0,16">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="None"
                            MinColumnSpacing="16"
                            MinRowSpacing="16"
                            MinItemWidth="160"
                            MinItemHeight="220"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                PointerEntered="OnGameCardPointerEntered"
                                PointerExited="OnGameCardPointerExited">
                                <!-- Main Card Button -->
                                <Button
                                    Click="OnGameItemClick"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                    <Border Style="{StaticResource GameGridCardStyle}">
                                        <Grid>
                                            <!-- Cover Image -->
                                            <Image
                                                Source="{Binding CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                                Stretch="UniformToFill"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="0,0,0,40"/>

                                            <!-- Favorite Badge -->
                                            <Border
                                                Background="{ThemeResource SystemAccentColor}"
                                                CornerRadius="4"
                                                Padding="4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="4"
                                                Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <FontIcon FontSize="12" Glyph="&#xE191;" Foreground="White"/>
                                            </Border>

                                            <!-- Game Info Overlay -->
                                            <Border
                                                Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                                                Opacity="0.9"
                                                VerticalAlignment="Bottom"
                                                CornerRadius="0,0,8,8"
                                                Padding="8,8"
                                                Height="40">
                                                <TextBlock
                                                    Text="{Binding DisplayName}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    TextWrapping="Wrap"
                                                    MaxHeight="28"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Button>

                                <!-- Quick Launch Button (shown on hover) -->
                                <Button
                                    x:Name="QuickLaunchOverlayButton"
                                    Click="OnQuickLaunchClick"
                                    Background="{ThemeResource SystemAccentColor}"
                                    CornerRadius="20"
                                    Width="44"
                                    Height="44"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Tag="{Binding}">
                                    <FontIcon FontSize="18" Glyph="&#xE768;" Foreground="White"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Games List (Table View) -->
            <ScrollViewer Grid.Row="2" Visibility="{x:Bind ViewModel.IsTableView, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <!-- Table Header -->
                    <Grid
                        x:Name="TableHeader"
                        Height="40"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        VerticalAlignment="Top"
                        ColumnSpacing="8"
                        Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cover Header -->
                        <TextBlock Grid.Column="0" Text="Cover" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                        <!-- Name (CN) Header - Sortable -->
                        <Button
                            Grid.Column="1"
                            Click="OnTableHeaderClick"
                            Tag="Name"
                            Background="Transparent"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Name (CN)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon FontSize="12" Glyph="&#xE8CB;" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Name (Original) Header - Sortable -->
                        <TextBlock Grid.Column="2" Text="Name (Original)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                        <!-- Status Header -->
                        <TextBlock Grid.Column="3" Text="Status" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                        <!-- Added Date Header - Sortable -->
                        <Button
                            Grid.Column="4"
                            Click="OnTableHeaderClick"
                            Tag="AddedTime"
                            Background="Transparent"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Added Date" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon FontSize="12" Glyph="&#xE8CB;" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Last Played Header - Sortable -->
                        <Button
                            Grid.Column="5"
                            Click="OnTableHeaderClick"
                            Tag="LastPlayed"
                            Background="Transparent"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Last Played" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon FontSize="12" Glyph="&#xE8CB;" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Play Time Header - Sortable -->
                        <Button
                            Grid.Column="6"
                            Click="OnTableHeaderClick"
                            Tag="PlayTime"
                            Background="Transparent"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Play Time" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon FontSize="12" Glyph="&#xE8CB;" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Table Content -->
                    <ListView
                        ItemsSource="{x:Bind ViewModel.FilteredGames, Mode=OneWay}"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="OnGameItemClick"
                        Margin="0,40,0,0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Padding="12,4" Height="56" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Cover Thumbnail -->
                                    <Border
                                        Grid.Column="0"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Width="48"
                                        Height="56">
                                        <Image
                                            Source="{Binding CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                            Stretch="UniformToFill"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name (CN) -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding NameCn}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center"
                                        MaxLines="1"/>

                                    <!-- Name (Original) -->
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding NameOriginal}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center"
                                        MaxLines="1"/>

                                    <!-- Status -->
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{Binding Converter={StaticResource GameStatusConverter}}"
                                        FontSize="12"
                                        Foreground="{ThemeResource SystemAccentColor}"
                                        VerticalAlignment="Center"/>

                                    <!-- Added Date -->
                                    <TextBlock
                                        Grid.Column="4"
                                        Text="{Binding AddedTime, Converter={StaticResource DateTimeFormatConverter}}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"/>

                                    <!-- Last Played -->
                                    <TextBlock
                                        Grid.Column="5"
                                        Text="{Binding LastSessionTime, Converter={StaticResource DateTimeFormatConverter}}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"/>

                                    <!-- Play Time -->
                                    <TextBlock
                                        Grid.Column="6"
                                        Text="{Binding FormattedPlayTime}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ScrollViewer>

            <!-- Empty State -->
            <StackPanel
                Grid.Row="2"
                Visibility="{x:Bind ViewModel.FilteredGamesCount, Mode=OneWay, Converter={StaticResource InverseCountToVisibilityConverter}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <FontIcon FontSize="48" Glyph="&#xE8FD;" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock
                    Text="No games found"
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"/>
                <TextBlock
                    Text="Try adjusting your search or filters, or add a new game"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center"/>
                <Button
                    Click="OnAddGameClick"
                    Content="Add Game"
                    Style="{StaticResource AccentButtonStyle}"
                    Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>