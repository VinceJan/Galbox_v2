<Page
    x:Class="Galbox.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Galbox.App.Converters"
    xmlns:models="using:Galbox.Data.Entities"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Register Converters -->
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter"/>
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <converters:EmptyStringToBooleanConverter x:Key="EmptyStringToBooleanConverter"/>
        <converters:PathToImageConverter x:Key="PathToImageConverter"/>
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>
        <converters:RatingConverter x:Key="RatingConverter"/>
        <converters:ByteSizeConverter x:Key="ByteSizeConverter"/>
        <converters:StatusFilterConverter x:Key="StatusFilterConverter"/>
        <converters:SortOptionConverter x:Key="SortOptionConverter"/>
        <converters:GameStatusConverter x:Key="GameStatusConverter"/>
        <!-- W14: the "folder is gone" badge. The decision logic lives in
             Services.GameInstallationStatus so the card, the detail page and the acceptance
             check cannot disagree. -->
        <converters:MissingInstallationToVisibilityConverter x:Key="MissingInstallationToVisibilityConverter"/>
        <converters:MissingInstallationBadgeConverter x:Key="MissingInstallationBadgeConverter"/>
        <converters:MissingInstallationTooltipConverter x:Key="MissingInstallationTooltipConverter"/>

        <!-- Styles - Local styles only, global styles defined in App.xaml -->
        <Style x:Key="LibraryCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Responsive Game Grid Card Style -->
        <Style x:Key="GameGridCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="MinHeight" Value="180"/>
        </Style>

        <!-- Responsive Search TextBox -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="PlaceholderText" Value="搜索游戏、开发商、角色..."/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="MaxWidth" Value="400"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- Game Card Template for Grid View - Not used, inline template used instead -->
        <DataTemplate x:Key="GameGridCardTemplate">
            <Grid>
                <Button
                    Click="OnGameItemClick"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <Border Style="{StaticResource GameGridCardStyle}">
                        <Grid>
                            <!-- Cover Image -->
                            <Image
                                Source="{Binding CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                Stretch="UniformToFill"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,40"/>

                            <!-- Favorite Badge -->
                            <Border
                                Background="{ThemeResource SystemAccentColor}"
                                CornerRadius="4"
                                Padding="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="4"
                                Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <FontIcon FontSize="12" Glyph="&#xE191;" Foreground="White"/>
                            </Border>

                            <!-- Game Info Overlay -->
                            <Border
                                Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                                Opacity="0.9"
                                VerticalAlignment="Bottom"
                                CornerRadius="0,0,8,8"
                                Padding="8,8"
                                Height="40">
                                <TextBlock
                                    Text="{Binding DisplayName}"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap"
                                    MaxHeight="28"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Button>

                <!-- Quick Launch Button (shown on hover) -->
                <Button
                    x:Name="QuickLaunchButton"
                    Click="OnQuickLaunchClick"
                    Tag="{Binding}"
                    Background="{ThemeResource SystemAccentColor}"
                    CornerRadius="20"
                    Width="40"
                    Height="40"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <FontIcon FontSize="16" Glyph="&#xE768;" Foreground="White"/>
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <!-- Loading Indicator -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Error Message -->
        <InfoBar
            Title="错误"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource EmptyStringToBooleanConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16"/>

        <!-- Success Message -->
        <InfoBar
            Title="成功"
            Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
            Severity="Success"
            IsOpen="{x:Bind ViewModel.SuccessMessage, Mode=OneWay, Converter={StaticResource EmptyStringToBooleanConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16,16,16,48"/>

        <!-- Main Content -->
        <Grid
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
            Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: Title + View Toggle + Add Button -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBlock
                    Grid.Column="0"
                    Text="游戏库"
                    FontSize="{StaticResource FontSizeTitle}"
                    FontWeight="Bold"/>

                <!-- Games Count -->
                <TextBlock
                    Grid.Column="1"
                    FontSize="{StaticResource FontSizeNormal}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">
                    <Run Text="{x:Bind ViewModel.FilteredGamesCount, Mode=OneWay}"/>
                    <Run Text="/"/>
                    <Run Text="{x:Bind ViewModel.TotalGamesCount, Mode=OneWay}"/>
                    <Run Text="个游戏"/>
                </TextBlock>

                <!-- Search Box -->
                <TextBox
                    Grid.Column="2"
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource SearchTextBoxStyle}"
                    TabIndex="0"
                    HorizontalAlignment="Right"
                    Margin="0,0,16,0"/>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                    <!-- Scan Folder Button (batch add) -->
                    <Button
                        Click="OnScanFolderClick"
                        TabIndex="1"
                        Width="40"
                        Height="40"
                        Padding="0"
                        ToolTipService.ToolTip="批量扫描游戏文件夹">
                        <FontIcon FontSize="16" Glyph="&#xE895;"/>
                    </Button>

                    <!-- Add Game Button -->
                    <Button
                        Click="OnAddGameClick"
                        TabIndex="2"
                        Width="40"
                        Height="40"
                        Padding="0"
                        ToolTipService.ToolTip="添加单个游戏文件夹">
                        <FontIcon FontSize="16" Glyph="&#xE710;"/>
                    </Button>

                    <!-- Grid View Toggle -->
                    <ToggleButton
                        IsChecked="{x:Bind ViewModel.IsGridView, Mode=OneWay}"
                        Click="OnToggleViewClick"
                        TabIndex="3"
                        Width="40"
                        Height="40"
                        Padding="0"
                        ToolTipService.ToolTip="网格视图">
                        <FontIcon FontSize="16" Glyph="&#xE80A;"/>
                    </ToggleButton>

                    <!-- Table View Toggle -->
                    <ToggleButton
                        IsChecked="{x:Bind ViewModel.IsTableView, Mode=OneWay}"
                        Click="OnToggleViewClick"
                        TabIndex="4"
                        Width="40"
                        Height="40"
                        Padding="0"
                        ToolTipService.ToolTip="表格视图">
                        <FontIcon FontSize="16" Glyph="&#xE80C;"/>
                    </ToggleButton>

                    <!-- Refresh Button -->
                    <Button
                        Click="OnRefreshClick"
                        TabIndex="5"
                        Width="40"
                        Height="40"
                        Padding="0"
                        Margin="8,0,0,0"
                        ToolTipService.ToolTip="刷新游戏库">
                        <FontIcon FontSize="16" Glyph="&#xE72C;"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Filters Section -->
            <Border
                Grid.Row="1"
                Style="{StaticResource LibraryCardStyle}"
                Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <!-- Status Filter -->
                    <ComboBox
                        Header="状态"
                        TabIndex="6"
                        SelectedIndex="{x:Bind ViewModel.StatusFilter, Converter={StaticResource StatusFilterConverter}, Mode=TwoWay}"
                        MinWidth="120"
                        MaxWidth="180"
                        Width="Auto">
                        <ComboBoxItem Content="全部"/>
                        <ComboBoxItem Content="收藏"/>
                        <ComboBoxItem Content="正在游玩"/>
                        <ComboBoxItem Content="已完成"/>
                        <ComboBoxItem Content="从未游玩"/>
                        <ComboBoxItem Content="最近添加"/>
                    </ComboBox>

                    <!-- Sort Option -->
                    <ComboBox
                        Header="排序方式"
                        TabIndex="7"
                        SelectedIndex="{x:Bind ViewModel.SortOption, Converter={StaticResource SortOptionConverter}, Mode=TwoWay}"
                        MinWidth="120"
                        MaxWidth="180"
                        Width="Auto">
                        <ComboBoxItem Content="添加时间（最新）"/>
                        <ComboBoxItem Content="添加时间（最早）"/>
                        <ComboBoxItem Content="名称（A-Z）"/>
                        <ComboBoxItem Content="名称（Z-A）"/>
                        <ComboBoxItem Content="发布日期"/>
                        <ComboBoxItem Content="游玩时间"/>
                        <ComboBoxItem Content="最后游玩"/>
                        <ComboBoxItem Content="评分"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Games List (Grid View) -->
            <ScrollViewer Grid.Row="2" Visibility="{x:Bind ViewModel.IsGridView, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsRepeater
                    x:Name="GamesGridRepeater"
                    ItemsSource="{x:Bind ViewModel.FilteredGames, Mode=OneWay}"
                    Margin="0,0,0,16">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="None"
                            MinColumnSpacing="12"
                            MinRowSpacing="12"
                            MinItemWidth="140"
                            MinItemHeight="180"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                PointerEntered="OnGameCardPointerEntered"
                                PointerExited="OnGameCardPointerExited"
                                ToolTipService.ToolTip="{Binding Converter={StaticResource MissingInstallationTooltipConverter}}">
                                <!-- Main Card Button -->
                                <Button
                                    Click="OnGameItemClick"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                    <Border Style="{StaticResource GameGridCardStyle}">
                                        <Grid>
                                            <!-- Cover Image -->
                                            <Image
                                                Source="{Binding CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                                Stretch="UniformToFill"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="0,0,0,40"/>

                                            <!-- W14: Missing installation badge - shown on top of the
                                                 (blank) cover so a dead library entry can never look
                                                 like a healthy one. -->
                                            <Border
                                                x:Name="MissingFolderBadge"
                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="4"
                                                Visibility="{Binding Converter={StaticResource MissingInstallationToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon FontSize="12" Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                                    <TextBlock
                                                        Text="{Binding Converter={StaticResource MissingInstallationBadgeConverter}}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Favorite Badge -->
                                            <Border
                                                Background="{ThemeResource SystemAccentColor}"
                                                CornerRadius="4"
                                                Padding="4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="4"
                                                Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <FontIcon FontSize="12" Glyph="&#xE191;" Foreground="White"/>
                                            </Border>

                                            <!-- Game Info Overlay -->
                                            <Border
                                                Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                                                Opacity="0.9"
                                                VerticalAlignment="Bottom"
                                                CornerRadius="0,0,8,8"
                                                Padding="8,8"
                                                Height="40">
                                                <TextBlock
                                                    Text="{Binding DisplayName}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    TextWrapping="Wrap"
                                                    MaxHeight="28"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Button>

                                <!-- Quick Launch Button (shown on hover) -->
                                <Button
                                    x:Name="QuickLaunchOverlayButton"
                                    Click="OnQuickLaunchClick"
                                    Background="{ThemeResource SystemAccentColor}"
                                    CornerRadius="20"
                                    Width="44"
                                    Height="44"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Tag="{Binding}">
                                    <FontIcon FontSize="18" Glyph="&#xE768;" Foreground="White"/>
                                </Button>

                                <!-- W13: Delete button (shown on hover). Removing a game only touches
                                     the library, never the game files. -->
                                <Button
                                    x:Name="DeleteGameOverlayButton"
                                    Click="OnDeleteGameClick"
                                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                                    CornerRadius="20"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="6"
                                    Visibility="Collapsed"
                                    ToolTipService.ToolTip="从库中移除（不会删除游戏文件）"
                                    Tag="{Binding}">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" Foreground="White"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Games List (Table View) -->
            <ScrollViewer Grid.Row="2" Visibility="{x:Bind ViewModel.IsTableView, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <!-- Table Header -->
                    <Grid
                        x:Name="TableHeader"
                        Height="40"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        VerticalAlignment="Top"
                        ColumnSpacing="8"
                        Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="60"/>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="2*" MinWidth="120"/>
                            <ColumnDefinition Width="Auto" MinWidth="80"/>
                            <ColumnDefinition Width="Auto" MinWidth="100"/>
                            <ColumnDefinition Width="Auto" MinWidth="100"/>
                            <ColumnDefinition Width="Auto" MinWidth="80"/>
                            <ColumnDefinition Width="Auto" MinWidth="48"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cover Header -->
                        <TextBlock Grid.Column="0" Text="封面" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                        <!-- Name (CN) Header - Sortable -->
                        <Button
                            Grid.Column="1"
                            Click="OnTableHeaderClick"
                            Tag="Name"
                            Background="Transparent"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="名称（中文）" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon FontSize="12" Glyph="&#xE8CB;" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Name (Original) Header - Sortable -->
                        <TextBlock Grid.Column="2" Text="名称（原名）" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                        <!-- Status Header -->
                        <TextBlock Grid.Column="3" Text="状态" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                        <!-- Added Date Header - Sortable -->
                        <Button
                            Grid.Column="4"
                            Click="OnTableHeaderClick"
                            Tag="AddedTime"
                            Background="Transparent"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="添加日期" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon FontSize="12" Glyph="&#xE8CB;" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Last Played Header - Sortable -->
                        <Button
                            Grid.Column="5"
                            Click="OnTableHeaderClick"
                            Tag="LastPlayed"
                            Background="Transparent"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="最后游玩" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon FontSize="12" Glyph="&#xE8CB;" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Play Time Header - Sortable -->
                        <Button
                            Grid.Column="6"
                            Click="OnTableHeaderClick"
                            Tag="PlayTime"
                            Background="Transparent"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="游玩时间" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon FontSize="12" Glyph="&#xE8CB;" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- W13: actions column (delete) -->
                        <TextBlock Grid.Column="7" Text="操作" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Table Content -->
                    <ListView
                        ItemsSource="{x:Bind ViewModel.FilteredGames, Mode=OneWay}"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="OnGameItemClick"
                        Margin="0,40,0,0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Padding="12,4" Height="56" VerticalAlignment="Center"
                                      ToolTipService.ToolTip="{Binding Converter={StaticResource MissingInstallationTooltipConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="60"/>
                                        <ColumnDefinition Width="*" MinWidth="150"/>
                                        <ColumnDefinition Width="2*" MinWidth="120"/>
                                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                                        <ColumnDefinition Width="Auto" MinWidth="48"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Cover Thumbnail -->
                                    <Border
                                        Grid.Column="0"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Width="48"
                                        Height="56">
                                        <Image
                                            Source="{Binding CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                            Stretch="UniformToFill"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name (CN) -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding NameCn}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center"
                                        MaxLines="1"/>

                                    <!-- Name (Original) -->
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding NameOriginal}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center"
                                        MaxLines="1"/>

                                    <!-- Status -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{Binding Converter={StaticResource GameStatusConverter}}"
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemAccentColor}"
                                            VerticalAlignment="Center"/>
                                        <!-- W14: missing installation marker -->
                                        <Border
                                            x:Name="MissingFolderPill"
                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding Converter={StaticResource MissingInstallationToVisibilityConverter}}">
                                            <TextBlock
                                                Text="{Binding Converter={StaticResource MissingInstallationBadgeConverter}}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Added Date -->
                                    <TextBlock
                                        Grid.Column="4"
                                        Text="{Binding AddedTime, Converter={StaticResource DateTimeFormatConverter}}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"/>

                                    <!-- Last Played -->
                                    <TextBlock
                                        Grid.Column="5"
                                        Text="{Binding LastSessionTime, Converter={StaticResource DateTimeFormatConverter}}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"/>

                                    <!-- Play Time -->
                                    <TextBlock
                                        Grid.Column="6"
                                        Text="{Binding FormattedPlayTime}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"/>

                                    <!-- W13: remove from library (game files are never touched) -->
                                    <Button
                                        x:Name="TableDeleteGameButton"
                                        Grid.Column="7"
                                        Click="OnDeleteGameClick"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4"
                                        Tag="{Binding}"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="从库中移除（不会删除游戏文件）">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ScrollViewer>

            <!-- Empty State -->
            <StackPanel
                Grid.Row="2"
                Visibility="{x:Bind ViewModel.FilteredGamesCount, Mode=OneWay, Converter={StaticResource InverseCountToVisibilityConverter}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <FontIcon FontSize="48" Glyph="&#xE8FD;" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock
                    Text="未找到游戏"
                    FontSize="{StaticResource FontSizeMedium}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"/>
                <TextBlock
                    Text="尝试调整搜索条件或筛选器，或添加新游戏"
                    FontSize="{StaticResource FontSizeNormal}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center"/>
                <Button
                    Click="OnAddGameClick"
                    Content="添加游戏"
                    Style="{StaticResource AccentButtonStyle}"
                    Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>