<Page
    x:Class="Galbox.App.Views.PatchCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Galbox.App.Converters"
    xmlns:models="using:Galbox.Data.Entities"
    xmlns:vm="using:Galbox.App.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Register Converters -->
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter"/>
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <converters:EmptyStringToBooleanConverter x:Key="EmptyStringToBooleanConverter"/>
        <converters:PathToImageConverter x:Key="PathToImageConverter"/>
        <converters:ByteSizeConverter x:Key="ByteSizeConverter"/>
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>

        <!-- Custom Converters -->
        <converters:PatchTypeFilterConverter x:Key="PatchTypeFilterConverter"/>
        <converters:PatchStatusToVisibilityConverter x:Key="PatchStatusToVisibilityConverter"/>
        <converters:PatchTypeToColorConverter x:Key="PatchTypeToColorConverter"/>
        <converters:PatchOperationStatusTextConverter x:Key="PatchOperationStatusTextConverter"/>
        <converters:PatchOperationActionTextConverter x:Key="PatchOperationActionTextConverter"/>

        <!-- Styles - Local styles only, global styles defined in App.xaml -->
        <Style x:Key="PatchCenterCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="PatchSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Patch Type Badge Colors - Use semantic colors for theme support -->
        <!-- Translation: Green (success) -->
        <SolidColorBrush x:Key="TranslationPatchColor" Color="{StaticResource SystemAccentColor}"/>
        <!-- Fix: Blue (info) -->
        <SolidColorBrush x:Key="FixPatchColor" Color="{StaticResource SystemAccentColor}"/>
        <!-- Adult: Pink/Magenta (accent) -->
        <SolidColorBrush x:Key="AdultPatchColor" Color="{StaticResource SystemAccentColor}"/>
        <!-- Other: Neutral gray -->
        <SolidColorBrush x:Key="OtherPatchColor" Color="{StaticResource TextFillColorSecondary}"/>

        <!-- Patch Details Flyout -->
        <!-- REMOVED from Page.Resources on purpose.
             It used to be a <Flyout x:Key="PatchDetailsFlyoutKey"> declared here with
             Text="{x:Bind ViewModel.PatchDetailContent}". An x:Bind inside a ResourceDictionary is
             resolved by the generated Initialize()/Update() pass, but the named elements of a lazily
             created resource are not connected at that moment, so the generated setter received a
             null TextBlock and threw NullReferenceException from FrameworkElement.Loading.
             Measured: opening 补丁中心 killed the whole process (Application Error 0xc000027b in
             Microsoft.UI.Xaml.dll) - on this branch AND on the unmodified 0e051ea baseline, i.e. the
             page was already unreachable before any patch-centre work. The flyout is now built in
             code-behind (PatchCenterPage.xaml.cs, BuildPatchDetailsFlyout) where the text is assigned
             to a live TextBlock that is guaranteed to exist. -->
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="24">
        <!-- Loading Indicator -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Error Message -->
        <InfoBar
            Title="错误"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource EmptyStringToBooleanConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16"/>

        <!-- Success Message -->
        <InfoBar
            Title="成功"
            Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
            Severity="Success"
            IsOpen="{x:Bind ViewModel.SuccessMessage, Mode=OneWay, Converter={StaticResource EmptyStringToBooleanConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16,16,16,48"/>

        <!-- Main Content -->
        <Grid
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBlock
                    Grid.Column="0"
                    Text="补丁中心"
                    FontSize="24"
                    FontWeight="Bold"/>

                <!-- Stats -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="24">
                    <StackPanel Orientation="Vertical">
                        <TextBlock
                            Text="{x:Bind ViewModel.GamesNeedingPatchesCount, Mode=OneWay}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemAccentColor}"
                            HorizontalAlignment="Center"/>
                        <TextBlock
                            Text="需要补丁的游戏"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical">
                        <TextBlock
                            Text="{x:Bind ViewModel.InstalledPatchesCount, Mode=OneWay}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemAccentColor}"
                            HorizontalAlignment="Center"/>
                        <TextBlock
                            Text="已安装补丁"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Refresh Button -->
                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Width="40"
                    Height="40"
                    Padding="0"
                    ToolTipService.ToolTip="刷新补丁">
                    <FontIcon FontSize="16" Glyph="&#xE72C;"/>
                </Button>
            </Grid>

            <!-- Main Two-Column Layout -->
            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="240" MaxWidth="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Games List -->
                <Border Grid.Column="0" Style="{StaticResource PatchCenterCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Games Header -->
                        <TextBlock
                            Grid.Row="0"
                            Text="需要补丁的游戏"
                            Style="{StaticResource PatchSectionHeaderStyle}"/>

                        <!-- Search Box -->
                        <TextBox
                            Grid.Row="1"
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="搜索游戏..."
                            CornerRadius="8"
                            Margin="0,0,0,8"/>

                        <!-- Games List -->
                        <ListView
                            Grid.Row="2"
                            ItemsSource="{x:Bind ViewModel.FilteredGamesNeedingPatches, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            ItemClick="OnGameItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Cover Thumbnail -->
                                        <Border
                                            Grid.Column="0"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Width="48"
                                            Height="48">
                                            <Image
                                                Source="{Binding CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                                Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- Game Name -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding DisplayName}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1"/>
                                            <TextBlock
                                                Text="{Binding Developer}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1"
                                                Visibility="{Binding Developer, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty Games State -->
                        <StackPanel
                            Grid.Row="2"
                            Visibility="{x:Bind ViewModel.GamesNeedingPatchesCount, Mode=OneWay, Converter={StaticResource InverseCountToVisibilityConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon FontSize="48" Glyph="&#xE8FD;" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock
                                Text="游戏库中没有游戏"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"/>
                            <TextBlock
                                Text="添加游戏以查看可用补丁"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Column: Patches Panel -->
                <Border Grid.Column="1" Style="{StaticResource PatchCenterCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Patches Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Selected Game Name -->
                            <TextBlock
                                Grid.Column="0"
                                FontSize="16"
                                FontWeight="SemiBold">
                                <Run Text="可用补丁："/>
                                <Run Text="{Binding SelectedGame.DisplayName}" Foreground="{ThemeResource SystemAccentColor}"/>
                            </TextBlock>

                            <!-- Patch Type Filter -->
                            <ComboBox
                                Grid.Column="2"
                                Header="补丁类型"
                                SelectedIndex="{x:Bind ViewModel.PatchTypeFilter, Converter={StaticResource PatchTypeFilterConverter}, Mode=TwoWay}"
                                Width="120"
                                HorizontalAlignment="Right">
                                <ComboBoxItem Content="全部"/>
                                <ComboBoxItem Content="汉化"/>
                                <ComboBoxItem Content="修复"/>
                                <ComboBoxItem Content="成人"/>
                                <ComboBoxItem Content="其他"/>
                            </ComboBox>
                        </Grid>

                        <!-- Selected Game Info -->
                        <Border
                            Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,12"
                            Visibility="{Binding SelectedGame, Converter={StaticResource NullToVisibilityConverter}}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Game Cover -->
                                <Border
                                    Grid.Column="0"
                                    CornerRadius="4"
                                    Width="80"
                                    Height="100">
                                    <Image
                                        Source="{Binding SelectedGame.CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                        Stretch="UniformToFill"/>
                                </Border>

                                <!-- Game Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding SelectedGame.DisplayName}"
                                        FontSize="18"
                                        FontWeight="Bold"/>
                                    <TextBlock
                                        Text="{Binding SelectedGame.Developer}"
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Margin="0,4,0,0"/>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Margin="0,4,0,0">
                                        <Run Text="{x:Bind ViewModel.AvailablePatchesCount, Mode=OneWay}"/>
                                        <Run Text="个可用补丁"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Navigate to Game Button -->
                                <Button
                                    Grid.Column="2"
                                    Content="查看游戏"
                                    Command="{x:Bind ViewModel.NavigateToGameCommand}"
                                    CommandParameter="{Binding SelectedGame}"
                                    VerticalAlignment="Center"
                                    CornerRadius="8"/>
                            </Grid>
                        </Border>

                        <!-- No Game Selected Message.
                             Was bound to NullToVisibilityConverter, i.e. it was shown precisely when a
                             game WAS selected - and therefore appeared at the same time as the game
                             card above it. Inverted. -->
                        <StackPanel
                            Grid.Row="1"
                            Visibility="{Binding SelectedGame, Converter={StaticResource InverseNullToVisibilityConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,0,0,12">
                            <TextBlock
                                Text="从列表中选择游戏以查看可用补丁"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Patches List -->
                        <!-- HorizontalScrollMode/BarVisibility are DISABLED on purpose: a ScrollViewer
                             otherwise measures its content with an infinite width, so every
                             TextWrapping="Wrap" TextBlock inside reports its full single-line width,
                             the content becomes far wider than the column and the whole right-hand
                             panel is clipped at the window edge (measured: the "本地补丁包" card was
                             cut off). Disabling horizontal scrolling makes the content wrap to the
                             column instead. -->
                        <ScrollViewer
                            Grid.Row="2"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Disabled"
                            Visibility="{Binding SelectedGame, Converter={StaticResource NullToVisibilityConverter}}">
                          <StackPanel Spacing="12">
                            <ItemsRepeater
                                ItemsSource="{x:Bind ViewModel.FilteredPatches, Mode=OneWay}"
                                Margin="0,0,0,8">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="12"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="8"
                                            Padding="16">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Patch Type Badge -->
                                                <Border
                                                    Grid.Column="0"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding PatchType, Converter={StaticResource PatchTypeToColorConverter}}">
                                                    <TextBlock
                                                        Text="{Binding PatchTypeDisplay}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="White"/>
                                                </Border>

                                                <!-- Patch Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis"
                                                        MaxLines="1"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="8">
                                                        <TextBlock
                                                            Text="{Binding Version}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Visibility="{Binding Version, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                                        <TextBlock
                                                            Text="{Binding FormattedSize}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock
                                                            Text="{Binding Source}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Visibility="{Binding Source, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                                    </StackPanel>

                                                    <!-- Download Progress (shown when downloading) -->
                                                    <ProgressBar
                                                        Value="{Binding DownloadProgress}"
                                                        Maximum="100"
                                                        Margin="0,8,0,0"
                                                        Visibility="{Binding Status, Converter={StaticResource PatchStatusToVisibilityConverter}}"
                                                        ShowPaused="False"
                                                        ShowError="False"/>
                                                </StackPanel>

                                                <!-- Action Buttons -->
                                                <!-- The download/install buttons were removed together with
                                                     their commands: neither did anything real (a sleep loop
                                                     and a fabricated local path). Patch sources are a
                                                     separate work line; until then this page only shows what
                                                     really exists in the database. -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <!-- Installed Badge -->
                                                    <Border
                                                        Background="{ThemeResource SystemAccentColor}"
                                                        CornerRadius="4"
                                                        Padding="12,6"
                                                        Visibility="{Binding Status, Converter={StaticResource PatchStatusToVisibilityConverter}, ConverterParameter=Installed}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon FontSize="14" Glyph="&#xE73E;" Foreground="White"/>
                                                            <TextBlock Text="已安装" FontWeight="SemiBold" Foreground="White"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Details Button -->
                                                    <Button
                                                        Click="OnPatchDetailsClick"
                                                        Tag="{Binding}"
                                                        CornerRadius="8"
                                                        Padding="12,6"
                                                        Background="Transparent">
                                                        <Button.Content>
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon FontSize="14" Glyph="&#xE946;"/>
                                                                <TextBlock Text="详情"/>
                                                            </StackPanel>
                                                        </Button.Content>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- 尚无数据库补丁记录时的说明（原来是一个覆盖在 ScrollViewer 之上的
                                 同级元素，本地补丁卡片加入后会和它重叠，所以搬进滚动内容里）。 -->
                            <StackPanel
                                Spacing="8"
                                Margin="0,4,0,4"
                                HorizontalAlignment="Center"
                                Visibility="{x:Bind ViewModel.AvailablePatchesCount, Mode=OneWay, Converter={StaticResource InverseCountToVisibilityConverter}}">
                                <FontIcon FontSize="48" Glyph="&#xE771;" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock
                                    Text="暂无可用补丁"
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    HorizontalAlignment="Center"/>
                                <TextBlock
                                    Text="数据库里还没有这个游戏的补丁记录。可以点上面的「查找在线补丁」到 moyu.moe 查这个作品，也可以用下面的「本地补丁包」安装一个已经下载好的补丁。"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap"
                                    MaxWidth="360"
                                    TextAlignment="Center"
                                    HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- ==================================================================
                                 本地补丁包（已下载）—— 补丁中心真正落盘的那一半
                                 引擎能力：Inspect / Preview / Install（可取消、带进度）/ Rollback /
                                 GetStatus / FindInterrupted + Recover。
                                 上面「在线补丁源：moyu.moe」负责发现并把浏览器下载下来的文件接管到这个
                                 入口（同一条链路），这里同时保留手动选包，两条路都进同一个引擎。
                                 ================================================================== -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Padding="16">
                                <StackPanel Spacing="12">

                                    <!-- ==================================================================
                                         在线补丁源：moyu.moe（官方公开面 /v2/moyu）—— 已接通。
                                         形态：查询 -> 打开补丁页（浏览器）-> 接管下载文件夹 -> 已有的
                                         IPatchEngine 走「预览 -> 安装 -> 回滚」。
                                         四种结果各有各的文案与状态码，不共用一个说法：
                                           MOYU_NOT_CONFIGURED 未配置 nmk_ 密钥（且不发请求）
                                           MOYU_NO_ANCHOR      该作品没有 vndb 标识（且不发请求）
                                           MOYU_NO_RESULTS     查询成功但没有补丁
                                           MOYU_QUERY_FAILED   查询失败（网络 / 上游 / 限流），带原始原因
                                         站方 robots.txt 的 Disallow: /api 由 MoyuComplianceGuard 在
                                         运行时强制，本页不构造任何越界的请求地址。
                                         ================================================================== -->
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{x:Bind ViewModel.MoyuSourceTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock
                                            Text="{x:Bind ViewModel.MoyuSourceDescription, Mode=OneWay}"
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                                        <!-- 查询 -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Command="{x:Bind ViewModel.FindMoyuPatchesCommand}"
                                                CommandParameter="{Binding SelectedGame}"
                                                IsEnabled="{x:Bind ViewModel.IsMoyuQuerying, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontSize="14" Glyph="&#xE721;"/>
                                                    <TextBlock Text="{x:Bind ViewModel.MoyuQueryButtonText, Mode=OneWay}"/>
                                                </StackPanel>
                                            </Button>
                                            <ProgressRing
                                                IsActive="{x:Bind ViewModel.IsMoyuQuerying, Mode=OneWay}"
                                                Width="20"
                                                Height="20"
                                                VerticalAlignment="Center"/>
                                            <TextBlock
                                                Text="{x:Bind ViewModel.MoyuLastQueryText, Mode=OneWay}"
                                                FontSize="12"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <!-- 状态：永远显示，且四种结果的说法互不相同 -->
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="10">
                                            <StackPanel Spacing="4">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap">
                                                    <Run Text="{x:Bind ViewModel.MoyuStatusCodeText, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{x:Bind ViewModel.MoyuStatusMessage, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock
                                                    Text="{x:Bind ViewModel.MoyuAdvisoryMessage, Mode=OneWay}"
                                                    FontSize="12"
                                                    TextWrapping="Wrap"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind ViewModel.MoyuAdvisoryMessage, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                                <!-- 只有「查询失败」才有这一段：失败与「没有结果」因此不可能被看成同一件事 -->
                                                <TextBlock
                                                    Text="{x:Bind ViewModel.MoyuErrorDetail, Mode=OneWay}"
                                                    FontSize="12"
                                                    TextWrapping="Wrap"
                                                    Foreground="#B91C1C"
                                                    Visibility="{x:Bind ViewModel.MoyuErrorDetail, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                                <TextBlock
                                                    FontSize="12"
                                                    TextWrapping="Wrap"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Visibility="{x:Bind ViewModel.MoyuAnchorUsed, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                                                    <Run Text="查询锚点："/>
                                                    <Run Text="{x:Bind ViewModel.MoyuAnchorUsed, Mode=OneWay}"/>
                                                    <Run Text="（moyu 只接受 vndb:/catalog: 两种锚点，不接受 Bangumi 条目 ID）"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <!-- 密钥：这是什么、去哪申请、当前能不能查 -->
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <Expander.Header>
                                                <TextBlock Text="nmk_ 密钥（官方公开面要求自备）" FontSize="13" FontWeight="SemiBold"/>
                                            </Expander.Header>
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{x:Bind ViewModel.MoyuKeySummary, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind ViewModel.MoyuKeyHowTo, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                <PasswordBox
                                                    Header="密钥"
                                                    PlaceholderText="nmk_..."
                                                    PasswordChanged="OnMoyuKeyPasswordChanged"
                                                    CornerRadius="8"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="保存密钥" Command="{x:Bind ViewModel.SaveMoyuKeyCommand}" CornerRadius="8"/>
                                                    <Button Content="清除密钥" Command="{x:Bind ViewModel.ClearMoyuKeyCommand}" CornerRadius="8"/>
                                                </StackPanel>
                                                <TextBlock
                                                    Text="{x:Bind ViewModel.MoyuKeySaveMessage, Mode=OneWay}"
                                                    FontSize="12"
                                                    TextWrapping="Wrap"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind ViewModel.MoyuKeySaveMessage, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Expander>

                                        <!-- 找到的补丁页 -->
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.MoyuPatches, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="10" Margin="0,2,0,2">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                                <Run Text="{Binding TypesText}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding SizeText}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding UpdatedText}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding ResourceCountText}"/>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding WebUrlText}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                            <TextBlock Text="{Binding LanguagesText}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Button
                                                                    Content="查看资源"
                                                                    Command="{Binding RefreshCommand}"
                                                                    CornerRadius="8"/>
                                                                <Button
                                                                    Command="{Binding OpenPageCommand}"
                                                                    IsEnabled="{Binding HasWebUrl}"
                                                                    CornerRadius="8">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <FontIcon FontSize="14" Glyph="&#xE774;"/>
                                                                        <TextBlock Text="打开补丁页"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 资源：真正要下载的东西，以及「下载怎么发生」的那段说明 -->
                                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasMoyuResources, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="这个补丁页上的资源" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock
                                                Text="{x:Bind ViewModel.MoyuDownloadModelExplanation, Mode=OneWay}"
                                                FontSize="12"
                                                TextWrapping="Wrap"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.MoyuResources, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="10" Margin="0,2,0,2">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                                    <Run Text="{Binding TypesText}"/>
                                                                    <Run Text=" · "/>
                                                                    <Run Text="{Binding SizeText}"/>
                                                                    <Run Text=" · "/>
                                                                    <Run Text="{Binding StorageText}"/>
                                                                    <Run Text=" · "/>
                                                                    <Run Text="{Binding UpdatedText}"/>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding WebUrlText}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                                <TextBlock
                                                                    Text="{Binding SaveTypeNotice}"
                                                                    FontSize="11"
                                                                    TextWrapping="Wrap"
                                                                    Foreground="#B45309"/>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Button Command="{Binding OpenPageCommand}" IsEnabled="{Binding HasWebUrl}" CornerRadius="8">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <FontIcon FontSize="14" Glyph="&#xE774;"/>
                                                                            <TextBlock Text="打开补丁页"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button Command="{Binding AdoptCommand}" CornerRadius="8">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <FontIcon FontSize="14" Glyph="&#xE896;"/>
                                                                            <TextBlock Text="接管下载"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <TextBlock
                                            Text="{x:Bind ViewModel.MoyuResourcesEmptyReason, Mode=OneWay}"
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Visibility="{x:Bind ViewModel.MoyuResourcesEmptyReason, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

                                        <!-- 浏览器跳转 与 下载接管 -->
                                        <TextBlock
                                            Text="{x:Bind ViewModel.MoyuLaunchMessage, Mode=OneWay}"
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind ViewModel.MoyuLaunchMessage, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

                                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsMoyuWatchingDownload, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ProgressBar IsIndeterminate="True" ShowPaused="False" ShowError="False"/>
                                            <TextBlock Text="{x:Bind ViewModel.MoyuWatchProgress, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/>
                                            <Button Content="取消等待" Command="{x:Bind ViewModel.CancelMoyuDownloadCommand}" CornerRadius="8" HorizontalAlignment="Left"/>
                                        </StackPanel>

                                        <TextBlock
                                            Text="{x:Bind ViewModel.MoyuDownloadMessage, Mode=OneWay}"
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind ViewModel.MoyuDownloadMessage, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <!-- 本地补丁包：接住上面那条链路产出的文件，也是手动选包的入口 -->
                                    <TextBlock Text="本地补丁包（已下载）" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock
                                        Text="选一个你已经下载到本机的补丁压缩包。Galbox 会先把它解压到临时沙箱，列出每个文件的落点、哪些会被覆盖、哪些条目会被拒绝；你确认之后才写入游戏目录，覆盖前会先备份。"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                                    <!-- 选择补丁包 -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Click="OnPickPatchArchiveClick" CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="14" Glyph="&#xE8E5;"/>
                                                <TextBlock Text="选择补丁压缩包..."/>
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Content="重新预览"
                                            Command="{x:Bind ViewModel.PreviewArchiveCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanPreview, Mode=OneWay}"
                                            CornerRadius="8"/>
                                        <Button
                                            Content="刷新台账"
                                            Command="{x:Bind ViewModel.RefreshPatchStateCommand}"
                                            CornerRadius="8"/>
                                    </StackPanel>

                                    <TextBlock
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.SelectedArchivePath, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.SelectedArchivePath, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

                                    <!-- 检查结果（Inspect） -->
                                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasArchiveInfo, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="包内容检查" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            Text="{x:Bind ViewModel.ArchiveSummary, Mode=OneWay}"/>
                                        <ItemsControl
                                            ItemsSource="{x:Bind ViewModel.ArchiveWarnings, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.HasArchiveWarnings, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Text="{Binding}"
                                                        FontSize="12"
                                                        TextWrapping="Wrap"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <InfoBar
                                            IsOpen="{x:Bind ViewModel.RequiresManualRun, Mode=OneWay}"
                                            IsClosable="False"
                                            Severity="Warning"
                                            Title="自解压可执行文件"
                                            Message="{x:Bind ViewModel.ManualRunAdvice, Mode=OneWay}"/>
                                    </StackPanel>

                                    <!-- 整个包被拒绝：必须说出来，不能显示成空的成功 -->
                                    <InfoBar
                                        IsOpen="{x:Bind ViewModel.PackageRejectionMessage, Mode=OneWay, Converter={StaticResource EmptyStringToBooleanConverter}}"
                                        IsClosable="False"
                                        Severity="Error"
                                        Title="这个补丁包没有被接受，没有写入任何文件"
                                        Message="{x:Bind ViewModel.PackageRejectionMessage, Mode=OneWay}"/>
                                    <TextBlock
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.PackageRejectionRemedy, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.PackageRejectionRemedy, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

                                    <!-- ================= 预览 ================= -->
                                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasPreview, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="覆盖预览" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            Text="{x:Bind ViewModel.PreviewHeadline, Mode=OneWay}"/>

                                        <!-- 将被覆盖的既有文件 -->
                                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasOverwriteEntries, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="将被覆盖的既有文件（覆盖前会先备份，可用「回滚」还原）" FontSize="12" FontWeight="SemiBold"/>
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.OverwriteEntries, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="8" Margin="0,2,0,2">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding TargetRelativePath}" FontSize="12" TextWrapping="Wrap"/>
                                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                                    <Run Text="{Binding ActionText}"/>
                                                                    <Run Text=" · "/>
                                                                    <Run Text="{Binding ProvenanceText}"/>
                                                                    <Run Text=" · "/>
                                                                    <Run Text="{Binding HashText}"/>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding SanitizationNote}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- 新增 -->
                                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasCreateEntries, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="新增文件" FontSize="12" FontWeight="SemiBold"/>
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.CreateEntries, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="8" Margin="0,2,0,2">
                                                            <TextBlock Text="{Binding TargetRelativePath}" FontSize="12" TextWrapping="Wrap"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- 冲突：必须逐个确认 -->
                                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasConflictEntries, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="冲突文件（来历不明，必须你确认后才会写入）" FontSize="12" FontWeight="SemiBold" Foreground="#C2410C"/>
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.ConflictEntries, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="8" Margin="0,2,0,2">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding TargetRelativePath}" FontSize="12" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Reason}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                                    <Run Text="{Binding ProvenanceText}"/>
                                                                    <Run Text=" · "/>
                                                                    <Run Text="{Binding HashText}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button
                                                Content="确认覆盖这些文件"
                                                Command="{x:Bind ViewModel.ConfirmConflictsCommand}"
                                                CornerRadius="8"
                                                HorizontalAlignment="Left"/>
                                        </StackPanel>

                                        <!-- 被拒绝的条目：与「将要写入」分开展示 -->
                                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasRejectedEntries, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="被拒绝的条目（永远不会写入，也不计入上面的数量）" FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C"/>
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.RejectedEntries, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="8" Margin="0,2,0,2">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding ArchiveEntryName}" FontSize="12" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Reason}" FontSize="11" TextWrapping="Wrap" Foreground="#B91C1C"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- 预览警告 -->
                                        <ItemsControl
                                            ItemsSource="{x:Bind ViewModel.PreviewWarnings, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.HasPreviewWarnings, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- ================= 安装 ================= -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Command="{x:Bind ViewModel.InstallPatchCommand}"
                                                CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontSize="14" Glyph="&#xE896;"/>
                                                    <TextBlock Text="安装到游戏目录"/>
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Content="取消安装"
                                                Command="{x:Bind ViewModel.InstallPatchCancelCommand}"
                                                CornerRadius="8"/>
                                        </StackPanel>

                                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsInstalling, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ProgressBar Value="{x:Bind ViewModel.InstallProgress, Mode=OneWay}" Maximum="1" ShowPaused="False" ShowError="False"/>
                                            <TextBlock Text="{x:Bind ViewModel.InstallPhase, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- 安装结果 -->
                                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.InstallResult, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind ViewModel.InstallSummary, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" FontWeight="SemiBold"/>

                                            <!-- 失败的文件：显式列出，绝不并入一句「安装成功」 -->
                                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasFailedOperations, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="没有成功的文件" FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C"/>
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.FailedOperations, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="8" Margin="0,2,0,2">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Text="{Binding RelativePath}" FontSize="12" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" Foreground="#B91C1C"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <ItemsControl
                                                ItemsSource="{x:Bind ViewModel.BlockingConflicts, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.HasBlockingConflicts, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Foreground="#B91C1C"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl
                                                ItemsSource="{x:Bind ViewModel.InstallErrors, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.HasInstallErrors, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Foreground="#B91C1C"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="逐文件结果" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.InstallOperations, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="11" TextWrapping="Wrap">
                                                            <Run Text="{Binding Status, Converter={StaticResource PatchOperationStatusTextConverter}}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding Action, Converter={StaticResource PatchOperationActionTextConverter}}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding RelativePath}"/>
                                                            <Run Text="{Binding Message}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- ================= 状态台账 ================= -->
                                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasStatusReport, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="这个游戏当前的补丁台账" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind ViewModel.StatusHeadline, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/>
                                        <!-- 事实 vs 推测：引擎的证据分级原样呈现 -->
                                        <TextBlock Text="{x:Bind ViewModel.StatusEvidenceText, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                                        <ItemsControl
                                            ItemsSource="{x:Bind ViewModel.ChangedSinceInstallFiles, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.HasChangedSinceInstallFiles, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="11" TextWrapping="Wrap">
                                                        <Run Text="{Binding State}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding RelativePath}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 启发式痕迹：明确标注这是推测 -->
                                        <ItemsControl
                                            ItemsSource="{x:Bind ViewModel.HeuristicTraces, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.HasHeuristicTraces, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                        <Run Text="[启发式痕迹]"/>
                                                        <Run Text="{Binding RelativePath}"/>
                                                        <Run Text=" — "/>
                                                        <Run Text="{Binding Detail}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{x:Bind ViewModel.StatusNotes, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- ================= 中断恢复 ================= -->
                                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasInterruptedPlans, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="检测到上次安装中断" FontSize="13" FontWeight="SemiBold" Foreground="#B91C1C"/>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.InterruptedPlans, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="8" Margin="0,2,0,2">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock FontSize="12" TextWrapping="Wrap">
                                                                <Run Text="{Binding PatchName}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding Reason}"/>
                                                            </TextBlock>
                                                            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                                <Run Text="可还原 "/>
                                                                <Run Text="{Binding RestorableFileCount}"/>
                                                                <Run Text=" 个文件，可移除 "/>
                                                                <Run Text="{Binding RemovableFileCount}"/>
                                                                <Run Text=" 个新增文件，无法判定 "/>
                                                                <Run Text="{Binding IndeterminateFileCount}"/>
                                                                <Run Text=" 个"/>
                                                            </TextBlock>
                                                            <Button
                                                                Content="恢复到安装前状态"
                                                                Tag="{Binding}"
                                                                Click="OnRecoverInterruptedClick"
                                                                CornerRadius="8"
                                                                HorizontalAlignment="Left"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- ================= 回滚 ================= -->
                                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasRollbackCandidates, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="可以回滚的安装记录" FontSize="13" FontWeight="SemiBold"/>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.RollbackCandidates, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="8" Margin="0,2,0,2">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Spacing="2">
                                                                <TextBlock Text="{Binding PatchName}" FontSize="12" TextWrapping="Wrap"/>
                                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                                    <Run Text="{Binding StatusText}"/>
                                                                    <Run Text=" · "/>
                                                                    <Run Text="{Binding FileCount}"/>
                                                                    <Run Text=" 个文件 · "/>
                                                                    <Run Text="{Binding InstallId}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Button
                                                                Grid.Column="1"
                                                                Content="回滚"
                                                                Tag="{Binding InstallId}"
                                                                Click="OnRollbackClick"
                                                                VerticalAlignment="Center"
                                                                CornerRadius="8"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <TextBlock
                                        Text="{x:Bind ViewModel.RollbackSummary, Mode=OneWay}"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind ViewModel.RollbackSummary, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

                                </StackPanel>
                            </Border>
                          </StackPanel>
                        </ScrollViewer>

                        <!-- No Patches Available.
                             Moved INSIDE the ScrollViewer above (it used to be a sibling of the
                             ScrollViewer in the same Grid.Row, which made it draw on top of the
                             scrolling content once that content grew taller than the empty area). -->
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>