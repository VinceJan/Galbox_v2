<Page
    x:Class="Galbox.App.Views.PatchCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Galbox.App.Converters"
    xmlns:models="using:Galbox.Data.Entities"
    xmlns:vm="using:Galbox.App.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Register Converters -->
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter"/>
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <converters:EmptyStringToBooleanConverter x:Key="EmptyStringToBooleanConverter"/>
        <converters:PathToImageConverter x:Key="PathToImageConverter"/>
        <converters:ByteSizeConverter x:Key="ByteSizeConverter"/>
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>

        <!-- Custom Converters -->
        <converters:PatchTypeFilterConverter x:Key="PatchTypeFilterConverter"/>
        <converters:PatchStatusToVisibilityConverter x:Key="PatchStatusToVisibilityConverter"/>
        <converters:PatchTypeToColorConverter x:Key="PatchTypeToColorConverter"/>

        <!-- Styles - Local styles only, global styles defined in App.xaml -->
        <Style x:Key="PatchCenterCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="PatchSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Patch Type Badge Colors - Use semantic colors for theme support -->
        <!-- Translation: Green (success) -->
        <SolidColorBrush x:Key="TranslationPatchColor" Color="{StaticResource SystemAccentColor}"/>
        <!-- Fix: Blue (info) -->
        <SolidColorBrush x:Key="FixPatchColor" Color="{StaticResource SystemAccentColor}"/>
        <!-- Adult: Pink/Magenta (accent) -->
        <SolidColorBrush x:Key="AdultPatchColor" Color="{StaticResource SystemAccentColor}"/>
        <!-- Other: Neutral gray -->
        <SolidColorBrush x:Key="OtherPatchColor" Color="{StaticResource TextFillColorSecondary}"/>

        <!-- Patch Details Flyout -->
        <Flyout x:Key="PatchDetailsFlyoutKey"
            Placement="Bottom"
            ShouldConstrainToRootBounds="False">
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="16"
                MinWidth="400"
                MaxWidth="500">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="补丁详情"
                        FontSize="18"
                        FontWeight="Bold"/>
                    <TextBlock
                        Text="{x:Bind ViewModel.PatchDetailContent, Mode=OneWay}"
                        TextWrapping="Wrap"
                        FontSize="14"/>
                </StackPanel>
            </Border>
        </Flyout>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="24">
        <!-- Loading Indicator -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Error Message -->
        <InfoBar
            Title="错误"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource EmptyStringToBooleanConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16"/>

        <!-- Success Message -->
        <InfoBar
            Title="成功"
            Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
            Severity="Success"
            IsOpen="{x:Bind ViewModel.SuccessMessage, Mode=OneWay, Converter={StaticResource EmptyStringToBooleanConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16,16,16,48"/>

        <!-- Main Content -->
        <Grid
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBlock
                    Grid.Column="0"
                    Text="补丁中心"
                    FontSize="24"
                    FontWeight="Bold"/>

                <!-- Stats -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="24">
                    <StackPanel Orientation="Vertical">
                        <TextBlock
                            Text="{x:Bind ViewModel.GamesNeedingPatchesCount, Mode=OneWay}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemAccentColor}"
                            HorizontalAlignment="Center"/>
                        <TextBlock
                            Text="需要补丁的游戏"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical">
                        <TextBlock
                            Text="{x:Bind ViewModel.InstalledPatchesCount, Mode=OneWay}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemAccentColor}"
                            HorizontalAlignment="Center"/>
                        <TextBlock
                            Text="已安装补丁"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Refresh Button -->
                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Width="40"
                    Height="40"
                    Padding="0"
                    ToolTipService.ToolTip="刷新补丁">
                    <FontIcon FontSize="16" Glyph="&#xE72C;"/>
                </Button>
            </Grid>

            <!-- Main Two-Column Layout -->
            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="240" MaxWidth="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Games List -->
                <Border Grid.Column="0" Style="{StaticResource PatchCenterCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Games Header -->
                        <TextBlock
                            Grid.Row="0"
                            Text="需要补丁的游戏"
                            Style="{StaticResource PatchSectionHeaderStyle}"/>

                        <!-- Search Box -->
                        <TextBox
                            Grid.Row="1"
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="搜索游戏..."
                            CornerRadius="8"
                            Margin="0,0,0,8"/>

                        <!-- Games List -->
                        <ListView
                            Grid.Row="2"
                            ItemsSource="{x:Bind ViewModel.FilteredGamesNeedingPatches, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            ItemClick="OnGameItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Cover Thumbnail -->
                                        <Border
                                            Grid.Column="0"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Width="48"
                                            Height="48">
                                            <Image
                                                Source="{Binding CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                                Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- Game Name -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding DisplayName}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1"/>
                                            <TextBlock
                                                Text="{Binding Developer}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1"
                                                Visibility="{Binding Developer, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty Games State -->
                        <StackPanel
                            Grid.Row="2"
                            Visibility="{x:Bind ViewModel.GamesNeedingPatchesCount, Mode=OneWay, Converter={StaticResource InverseCountToVisibilityConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon FontSize="48" Glyph="&#xE8FD;" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock
                                Text="游戏库中没有游戏"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"/>
                            <TextBlock
                                Text="添加游戏以查看可用补丁"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Column: Patches Panel -->
                <Border Grid.Column="1" Style="{StaticResource PatchCenterCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Patches Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Selected Game Name -->
                            <TextBlock
                                Grid.Column="0"
                                FontSize="16"
                                FontWeight="SemiBold">
                                <Run Text="可用补丁："/>
                                <Run Text="{Binding SelectedGame.DisplayName}" Foreground="{ThemeResource SystemAccentColor}"/>
                            </TextBlock>

                            <!-- Patch Type Filter -->
                            <ComboBox
                                Grid.Column="2"
                                Header="补丁类型"
                                SelectedIndex="{x:Bind ViewModel.PatchTypeFilter, Converter={StaticResource PatchTypeFilterConverter}, Mode=TwoWay}"
                                Width="120"
                                HorizontalAlignment="Right">
                                <ComboBoxItem Content="全部"/>
                                <ComboBoxItem Content="汉化"/>
                                <ComboBoxItem Content="修复"/>
                                <ComboBoxItem Content="成人"/>
                                <ComboBoxItem Content="其他"/>
                            </ComboBox>
                        </Grid>

                        <!-- Selected Game Info -->
                        <Border
                            Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,12"
                            Visibility="{Binding SelectedGame, Converter={StaticResource NullToVisibilityConverter}}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Game Cover -->
                                <Border
                                    Grid.Column="0"
                                    CornerRadius="4"
                                    Width="80"
                                    Height="100">
                                    <Image
                                        Source="{Binding SelectedGame.CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                        Stretch="UniformToFill"/>
                                </Border>

                                <!-- Game Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding SelectedGame.DisplayName}"
                                        FontSize="18"
                                        FontWeight="Bold"/>
                                    <TextBlock
                                        Text="{Binding SelectedGame.Developer}"
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Margin="0,4,0,0"/>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Margin="0,4,0,0">
                                        <Run Text="{x:Bind ViewModel.AvailablePatchesCount, Mode=OneWay}"/>
                                        <Run Text="个可用补丁"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Navigate to Game Button -->
                                <Button
                                    Grid.Column="2"
                                    Content="查看游戏"
                                    Command="{x:Bind ViewModel.NavigateToGameCommand}"
                                    CommandParameter="{Binding SelectedGame}"
                                    VerticalAlignment="Center"
                                    CornerRadius="8"/>
                            </Grid>
                        </Border>

                        <!-- No Game Selected Message -->
                        <StackPanel
                            Grid.Row="1"
                            Visibility="{Binding SelectedGame, Converter={StaticResource NullToVisibilityConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,0,0,12">
                            <TextBlock
                                Text="从列表中选择游戏以查看可用补丁"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Patches List -->
                        <ScrollViewer Grid.Row="2" Visibility="{Binding SelectedGame, Converter={StaticResource NullToVisibilityConverter}}">
                            <ItemsRepeater
                                ItemsSource="{x:Bind ViewModel.FilteredPatches, Mode=OneWay}"
                                Margin="0,0,0,8">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="12"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="8"
                                            Padding="16">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Patch Type Badge -->
                                                <Border
                                                    Grid.Column="0"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding PatchType, Converter={StaticResource PatchTypeToColorConverter}}">
                                                    <TextBlock
                                                        Text="{Binding PatchTypeDisplay}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="White"/>
                                                </Border>

                                                <!-- Patch Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis"
                                                        MaxLines="1"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="8">
                                                        <TextBlock
                                                            Text="{Binding Version}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Visibility="{Binding Version, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                                        <TextBlock
                                                            Text="{Binding FormattedSize}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock
                                                            Text="{Binding Source}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Visibility="{Binding Source, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                                    </StackPanel>

                                                    <!-- Download Progress (shown when downloading) -->
                                                    <ProgressBar
                                                        Value="{Binding DownloadProgress}"
                                                        Maximum="100"
                                                        Margin="0,8,0,0"
                                                        Visibility="{Binding Status, Converter={StaticResource PatchStatusToVisibilityConverter}}"
                                                        ShowPaused="False"
                                                        ShowError="False"/>
                                                </StackPanel>

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <!-- Download Button -->
                                                    <Button
                                                        Command="{Binding ViewModel.DownloadPatchCommand, ElementName=RootGrid}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding Status, Converter={StaticResource PatchStatusToVisibilityConverter}, ConverterParameter=Available}"
                                                        CornerRadius="8"
                                                        Padding="12,6">
                                                        <Button.Content>
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon FontSize="14" Glyph="&#xE896;"/>
                                                                <TextBlock Text="下载"/>
                                                            </StackPanel>
                                                        </Button.Content>
                                                    </Button>

                                                    <!-- Install Button -->
                                                    <Button
                                                        Command="{Binding ViewModel.InstallPatchCommand, ElementName=RootGrid}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding Status, Converter={StaticResource PatchStatusToVisibilityConverter}, ConverterParameter=Downloaded}"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        CornerRadius="8"
                                                        Padding="12,6">
                                                        <Button.Content>
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon FontSize="14" Glyph="&#xE75C;"/>
                                                                <TextBlock Text="安装"/>
                                                            </StackPanel>
                                                        </Button.Content>
                                                    </Button>

                                                    <!-- Installed Badge -->
                                                    <Border
                                                        Background="{ThemeResource SystemAccentColor}"
                                                        CornerRadius="4"
                                                        Padding="12,6"
                                                        Visibility="{Binding Status, Converter={StaticResource PatchStatusToVisibilityConverter}, ConverterParameter=Installed}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon FontSize="14" Glyph="&#xE73E;" Foreground="White"/>
                                                            <TextBlock Text="已安装" FontWeight="SemiBold" Foreground="White"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Details Button -->
                                                    <Button
                                                        Command="{Binding ViewModel.ShowPatchDetailsCommand, ElementName=RootGrid}"
                                                        CommandParameter="{Binding}"
                                                        CornerRadius="8"
                                                        Padding="12,6"
                                                        Background="Transparent">
                                                        <Button.Content>
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon FontSize="14" Glyph="&#xE946;"/>
                                                                <TextBlock Text="详情"/>
                                                            </StackPanel>
                                                        </Button.Content>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>

                        <!-- No Patches Available -->
                        <StackPanel
                            Grid.Row="2"
                            Visibility="{x:Bind ViewModel.AvailablePatchesCount, Mode=OneWay, Converter={StaticResource InverseCountToVisibilityConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon FontSize="48" Glyph="&#xE771;" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock
                                Text="暂无可用补丁"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"/>
                            <TextBlock
                                Text="该游戏可能没有可用的补丁"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>