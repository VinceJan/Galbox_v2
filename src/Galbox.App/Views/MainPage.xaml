<Page
    x:Class="Galbox.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Galbox.App.Converters"
    xmlns:models="using:Galbox.Data.Entities"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Register Converters -->
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter"/>
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <converters:EmptyStringToBooleanConverter x:Key="EmptyStringToBooleanConverter"/>
        <converters:PathToImageConverter x:Key="PathToImageConverter"/>
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>

        <!-- Styles - Local styles only, global styles defined in App.xaml -->
        <Style x:Key="QuickLaunchCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="MainPageSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <!-- Responsive Game Card Style - Use MinWidth/MinHeight instead of fixed dimensions -->
        <Style x:Key="GameCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MinHeight" Value="160"/>
        </Style>

        <Style x:Key="LaunchButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Padding" Value="16,10"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <!-- Loading Indicator -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Error Message -->
        <InfoBar
            Title="错误"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource EmptyStringToBooleanConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16"/>

        <!-- Main Content -->
        <ScrollViewer
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
            Padding="24">
            <StackPanel Orientation="Vertical" MaxWidth="1200" HorizontalAlignment="Center">

                <!-- Page Header -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical">
                        <TextBlock
                            Text="欢迎使用 Galbox"
                            FontSize="24"
                            FontWeight="Bold"/>

                        <TextBlock
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{x:Bind ViewModel.TotalGamesCount, Mode=OneWay}"/>
                            <Run Text="个游戏在你的游戏库中"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <!-- Add Game Button -->
                        <Button
                            Click="OnAddGameClick"
                            Style="{StaticResource AccentButtonStyle}"
                            CornerRadius="8"
                            Padding="16,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE710;"/>
                                <TextBlock Text="添加游戏" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Go to Library Button -->
                        <Button
                            Command="{x:Bind ViewModel.NavigateToLibraryCommand}"
                            CornerRadius="8"
                            Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontSize="16" Glyph="&#xE80A;"/>
                                <TextBlock Text="游戏库"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Quick Launch Section -->
                <Border
                    Style="{StaticResource QuickLaunchCardStyle}"
                    Visibility="{Binding QuickLaunchGame, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cover Image - Responsive sizing -->
                        <Border
                            Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="8"
                            MinWidth="80"
                            MaxWidth="150"
                            MinHeight="120"
                            MaxHeight="200">
                            <Image
                                Source="{Binding QuickLaunchGame.CoverImagePath, Mode=OneWay, Converter={StaticResource PathToImageConverter}}"
                                Stretch="UniformToFill"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <!-- Game Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <TextBlock
                                Text="{Binding QuickLaunchGame.DisplayName, Mode=OneWay}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                Text="{Binding QuickLaunchGame.Developer, Mode=OneWay}"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{Binding QuickLaunchGame.Developer, Mode=OneWay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{Binding QuickLaunchGame.LastSessionTime, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                                <Run Text="上次游玩： "/>
                                <Run Text="{Binding QuickLaunchGame.LastSessionTime, Mode=OneWay, Converter={StaticResource DateTimeFormatConverter}}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Launch Button -->
                        <Button
                            Grid.Column="2"
                            Command="{Binding NavigateToGameCommand}"
                            CommandParameter="{Binding QuickLaunchGame, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Style="{StaticResource LaunchButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE768;"/>
                                <TextBlock Text="启动"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Currently Playing Section -->
                <Grid>
                    <TextBlock
                        Text="正在游玩"
                        Style="{StaticResource MainPageSectionHeaderStyle}"
                        Visibility="{x:Bind ViewModel.CurrentlyPlayingGames.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}"/>

                    <HyperlinkButton
                        Content="查看全部"
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.NavigateToCurrentlyPlayingCommand}"
                        Margin="0,16,0,8"
                        Visibility="{x:Bind ViewModel.CurrentlyPlayingGames.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}"/>
                </Grid>

                <ItemsRepeater
                    ItemsSource="{x:Bind ViewModel.CurrentlyPlayingGames, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.CurrentlyPlayingGames.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}"
                    Margin="0,0,0,16">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="12"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Click="OnGameItemClick"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0">
                                <Border Style="{StaticResource GameCardStyle}">
                                    <Grid>
                                        <Image
                                            Source="{Binding CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                            Stretch="UniformToFill"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                        <Border
                                            Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                                            Opacity="0.8"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="0,0,8,8"
                                            Padding="8,4">
                                            <TextBlock
                                                Text="{Binding DisplayName}"
                                                FontSize="12"
                                                TextWrapping="Wrap"
                                                MaxHeight="40"
                                                TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Favorites Section -->
                <Grid>
                    <TextBlock
                        Text="收藏"
                        Style="{StaticResource MainPageSectionHeaderStyle}"
                        Visibility="{x:Bind ViewModel.FavoriteGames.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}"/>

                    <HyperlinkButton
                        Content="查看全部"
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.NavigateToFavoritesCommand}"
                        Margin="0,16,0,8"
                        Visibility="{x:Bind ViewModel.FavoriteGames.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}"/>
                </Grid>

                <ItemsRepeater
                    ItemsSource="{x:Bind ViewModel.FavoriteGames, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.FavoriteGames.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}"
                    Margin="0,0,0,16">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="12"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Click="OnGameItemClick"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0">
                                <Border Style="{StaticResource GameCardStyle}">
                                    <Grid>
                                        <Image
                                            Source="{Binding CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                            Stretch="UniformToFill"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                        <Border
                                            Background="{ThemeResource SystemAccentColor}"
                                            CornerRadius="4"
                                            Padding="4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="4">
                                            <FontIcon FontSize="12" Glyph="&#xE191;" Foreground="White"/>
                                        </Border>

                                        <Border
                                            Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                                            Opacity="0.8"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="0,0,8,8"
                                            Padding="8,4">
                                            <TextBlock
                                                Text="{Binding DisplayName}"
                                                FontSize="12"
                                                TextWrapping="Wrap"
                                                MaxHeight="40"
                                                TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Recent Games Section -->
                <Grid>
                    <TextBlock
                        Text="最近游玩"
                        Style="{StaticResource MainPageSectionHeaderStyle}"
                        Visibility="{x:Bind ViewModel.RecentGames.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}"/>

                    <HyperlinkButton
                        Content="查看全部"
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.NavigateToLibraryCommand}"
                        Margin="0,16,0,8"
                        Visibility="{x:Bind ViewModel.RecentGames.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}"/>
                </Grid>

                <ItemsRepeater
                    ItemsSource="{x:Bind ViewModel.RecentGames, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.RecentGames.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}"
                    Margin="0,0,0,16">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="12"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Click="OnGameItemClick"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0">
                                <Border Style="{StaticResource GameCardStyle}">
                                    <Grid>
                                        <Image
                                            Source="{Binding CoverImagePath, Converter={StaticResource PathToImageConverter}}"
                                            Stretch="UniformToFill"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                        <Border
                                            Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                                            Opacity="0.8"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="0,0,8,8"
                                            Padding="8,4">
                                            <TextBlock
                                                Text="{Binding DisplayName}"
                                                FontSize="12"
                                                TextWrapping="Wrap"
                                                MaxHeight="40"
                                                TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Empty State -->
                <StackPanel
                    Visibility="{x:Bind ViewModel.TotalGamesCount, Mode=OneWay, Converter={StaticResource InverseCountToVisibilityConverter}}"
                    HorizontalAlignment="Center"
                    Spacing="16"
                    Margin="32">
                    <FontIcon FontSize="48" Glyph="&#xE8FD;" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock
                        Text="游戏库中还没有游戏"
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"/>
                    <Button
                        Content="添加游戏"
                        Command="{x:Bind ViewModel.NavigateToLibraryCommand}"
                        HorizontalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>