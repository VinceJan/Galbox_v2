<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Galbox.App.Views.ErrorReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Galbox.App.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Register Converters -->
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter"/>
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <converters:EmptyStringToBooleanConverter x:Key="EmptyStringToBooleanConverter"/>
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>
        <!-- Chinese labels for the enum names stored in the ErrorRecords table. The mapping itself
             lives in Models\DiagnosisText.cs, so the model and this page cannot drift apart. -->
        <converters:ErrorSeverityDisplayConverter x:Key="ErrorSeverityDisplayConverter"/>
        <converters:ErrorCategoryDisplayConverter x:Key="ErrorCategoryDisplayConverter"/>
        <converters:ErrorSolutionTypeDisplayConverter x:Key="ErrorSolutionTypeDisplayConverter"/>

        <Style x:Key="ErrorCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ErrorCounterValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeLarge}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="24">
        <!-- Loading Indicator -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Error Message -->
        <InfoBar
            Title="错误"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource EmptyStringToBooleanConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16"/>

        <!-- Status Message -->
        <InfoBar
            Title="状态"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="Informational"
            IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource EmptyStringToBooleanConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="16,16,16,48"/>

        <ScrollViewer Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel Spacing="4" MaxWidth="1200" HorizontalAlignment="Stretch">

                <!-- Title and actions -->
                <TextBlock
                    Text="错误报告"
                    FontSize="{StaticResource FontSizeHeader}"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Text="检测游戏运行环境的常见问题（中文路径、区域设置、DirectX、编解码器、运行时依赖、权限、杀软拦截）。检测结果会写入数据库，未解决的问题在下方汇总。"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Margin="0,4,0,8"/>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                    <Button
                        Content="刷新列表"
                        Click="OnRefreshClick"/>
                    <Button
                        Content="重新检测全部游戏"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.BatchCheckAllGamesCommand}"/>
                </StackPanel>

                <!-- Counters -->
                <Border Style="{StaticResource ErrorCardStyle}">
                    <Grid ColumnSpacing="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="严重" FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.CriticalErrorCount, Mode=OneWay}"
                                       Style="{StaticResource ErrorCounterValueStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="重要" FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.MajorErrorCount, Mode=OneWay}"
                                       Style="{StaticResource ErrorCounterValueStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="未解决总数" FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.TotalUnresolvedCount, Mode=OneWay}"
                                       Style="{StaticResource ErrorCounterValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- All unresolved records (persisted) -->
                <Border Style="{StaticResource ErrorCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="库中未解决的问题" Style="{StaticResource SectionHeaderStyle}"/>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.AllUnresolvedErrors, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SolutionInstructions}" FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding SolutionInstructions, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Severity, Converter={StaticResource ErrorSeverityDisplayConverter}}"
                                                       FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Category, Converter={StaticResource ErrorCategoryDisplayConverter}}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding SolutionType, Converter={StaticResource ErrorSolutionTypeDisplayConverter}}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding DetectedTime, Converter={StaticResource DateTimeFormatConverter}}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right"/>
                                        </StackPanel>

                                        <Button
                                            Grid.Column="2"
                                            Content="标记已解决"
                                            VerticalAlignment="Center"
                                            Click="OnMarkRecordResolvedClick"
                                            Tag="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            Text="没有未解决的问题。点击「重新检测全部游戏」开始检测。"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.AllUnresolvedErrors.Count, Mode=OneWay, Converter={StaticResource InverseCountToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- Per game -->
                <Border Style="{StaticResource ErrorCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="按游戏查看" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock
                            Text="左侧是库中检测到过问题的游戏。选中一个游戏会重新运行检测，右侧显示结果；「自动修复」只在服务确实提供修复时出现。"
                            FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"/>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <ListView
                                    ItemsSource="{x:Bind ViewModel.GamesWithErrors, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}"
                                    SelectionChanged="OnGameSelectionChanged"
                                    MaxHeight="420">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Padding="0,6">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding InstallPath}" FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock
                                    Text="还没有游戏带有错误记录。"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Margin="0,8,0,0"
                                    Visibility="{x:Bind ViewModel.GamesWithErrors.Count, Mode=OneWay, Converter={StaticResource InverseCountToVisibilityConverter}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedGame.DisplayName, Mode=OneWay, TargetNullValue='未选择游戏'}"
                                    FontWeight="SemiBold"/>

                                <!-- 修复结果与撤销：一次修复改了用户的目录或注册表，必须能就地撤销 -->
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="8" Padding="12"
                                    Visibility="{x:Bind ViewModel.AppliedFixes.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="本次修复" FontWeight="SemiBold"/>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.AppliedFixes, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Spacing="2" Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                                        <ItemsControl ItemsSource="{Binding Notes}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                                               FontSize="{StaticResource FontSizeSmall}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Button
                                                            Content="撤销这次修复"
                                                            Click="OnUndoFixClick"
                                                            Tag="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Filters -->
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ComboBox
                                        Header="严重程度"
                                        MinWidth="160"
                                        ItemsSource="{x:Bind ViewModel.SeverityFilterOptions, Mode=OneWay}"
                                        DisplayMemberPath="DisplayName"
                                        SelectionChanged="OnSeverityFilterChanged"/>
                                    <ComboBox
                                        Header="类别"
                                        MinWidth="180"
                                        ItemsSource="{x:Bind ViewModel.CategoryFilterOptions, Mode=OneWay}"
                                        DisplayMemberPath="DisplayName"
                                        SelectionChanged="OnCategoryFilterChanged"/>
                                </StackPanel>

                                <!-- 规格 §3.5 的「一键修复所有问题」：只修可自动修复的项，并如实说明剩下的 -->
                                <Button
                                    Content="{x:Bind ViewModel.FixAllButtonText, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnFixAllClick"/>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredErrors, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                CornerRadius="8"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding SeverityDisplay}" FontWeight="SemiBold"/>
                                                    </Grid>

                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding SolutionInstructions}" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Visibility="{Binding SolutionInstructions, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

                                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                CornerRadius="4" Padding="8,2">
                                                            <TextBlock Text="{Binding SolutionTypeDisplay}" FontSize="{StaticResource FontSizeSmall}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding SolutionTypeDescription}" VerticalAlignment="Center"
                                                                   FontSize="{StaticResource FontSizeSmall}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button
                                                            Content="一键修复"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            Click="OnAttemptFixClick"
                                                            Tag="{Binding}"
                                                            Visibility="{Binding AutoFixAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <Button
                                                            Content="下载所需组件"
                                                            Click="OnOpenDownloadUrlClick"
                                                            Tag="{Binding}"
                                                            Visibility="{Binding DownloadUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                        <Button
                                                            Content="标记已解决"
                                                            Click="OnMarkResolvedClick"
                                                            Tag="{Binding}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock
                                    Text="选中游戏后这里会显示检测结果。没有结果表示该游戏当前没有检测到问题。"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.FilteredErrors.Count, Mode=OneWay, Converter={StaticResource InverseCountToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
