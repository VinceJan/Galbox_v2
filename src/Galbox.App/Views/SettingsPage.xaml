<Page
    x:Class="Galbox.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Galbox.App.Converters"
    xmlns:models="using:Galbox.Data.Entities"
    xmlns:viewmodels="using:Galbox.App.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Register Converters -->
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <converters:EmptyStringToBooleanConverter x:Key="EmptyStringToBooleanConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <!-- Settings Card Style - inherits from global CardStyle -->
        <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>

        <!-- Settings Section Header Style -->
        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>

        <!-- Launch Behavior Converter -->
        <converters:LaunchBehaviorConverter x:Key="LaunchBehaviorConverter"/>
        <converters:ExitBehaviorConverter x:Key="ExitBehaviorConverter"/>
        <converters:AppThemeConverter x:Key="AppThemeConverter"/>
        <converters:AppLanguageConverter x:Key="AppLanguageConverter"/>
        <converters:LibraryViewModeConverter x:Key="LibraryViewModeConverter"/>
        <converters:ScreenshotFormatConverter x:Key="ScreenshotFormatConverter"/>
        <converters:BossKeyModifierConverter x:Key="BossKeyModifierConverter"/>
        <converters:DefaultScrapingSourceConverter x:Key="DefaultScrapingSourceConverter"/>
        <converters:SettingsScreenshotFormatToJpgVisibilityConverter x:Key="SettingsScreenshotFormatToJpgVisibilityConverter"/>
        <converters:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter"/>
        <!-- W6: referenced by the "About" card; without this registration x:Bind's
             LookupConverter returns null and the whole binding throws while converting. -->
        <converters:SettingsVersionTextConverter x:Key="SettingsVersionTextConverter"/>
    </Page.Resources>

    <Grid Padding="24">
        <ScrollViewer>
            <StackPanel Spacing="8" MaxWidth="900" HorizontalAlignment="Center">
                <!-- Page Header -->
                <TextBlock
                    Text="设置"
                    FontSize="28"
                    FontWeight="Bold"
                    Margin="0,0,0,16"/>

                <!-- Loading Indicator -->
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Error Message -->
                <InfoBar
                    Title="错误"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource EmptyStringToBooleanConverter}}"
                    HorizontalAlignment="Stretch"
                    Margin="0,8,0,0"/>

                <!-- Success Message -->
                <InfoBar
                    Title="成功"
                    Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                    Severity="Success"
                    IsOpen="{x:Bind ViewModel.SuccessMessage, Mode=OneWay, Converter={StaticResource EmptyStringToBooleanConverter}}"
                    HorizontalAlignment="Stretch"
                    Margin="0,8,0,0"/>

                <!-- Save Button -->
                <Button
                    Command="{x:Bind ViewModel.SaveSettingsCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE74E;"/>
                        <TextBlock Text="保存设置"/>
                    </StackPanel>
                </Button>

                <!-- ==================== Scraping Settings ==================== -->
                <TextBlock
                    Text="刮削设置"
                    Style="{StaticResource SettingsSectionHeaderStyle}"/>

                <!-- Bangumi Source -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Bangumi" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="启用 Bangumi 作为元数据来源"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            IsOn="{x:Bind ViewModel.EnableBangumi, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <!-- VNDB Source -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="VNDB" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="启用 VNDB 作为元数据来源"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            IsOn="{x:Bind ViewModel.EnableVndb, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <!-- ymgal Source -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ymgal" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="启用 ymgal 作为元数据来源"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            IsOn="{x:Bind ViewModel.EnableYmgal, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <!-- cngal Source -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="cngal" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="启用 cngal 作为元数据来源"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            IsOn="{x:Bind ViewModel.EnableCngal, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <!-- Source Priority -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="来源优先级" FontWeight="SemiBold"/>
                        <TextBlock
                            Text="刮削时的来源顺序（优先级高的先使用）"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ListView
                            x:Name="SourcePriorityListView"
                            ItemsSource="{x:Bind ViewModel.SourcePriorityList, Mode=OneWay}"
                            SelectionMode="None"
                            Margin="0,8,0,0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:SourcePriorityItem">
                                    <Grid ColumnSpacing="8" Padding="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Grid.Column="0"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            Click="OnMoveSourceUpClick"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="上移">
                                            <FontIcon FontSize="12" Glyph="&#xE74A;"/>
                                        </Button>
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding DisplayName}"
                                            VerticalAlignment="Center"/>
                                        <Button
                                            Grid.Column="2"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            Click="OnMoveSourceDownClick"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="下移">
                                            <FontIcon FontSize="12" Glyph="&#xE74B;"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Match Threshold -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="匹配阈值" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="匹配百分比超过阈值时自动接受刮削数据"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Slider
                                Value="{x:Bind ViewModel.MatchThreshold, Mode=TwoWay}"
                                Minimum="50"
                                Maximum="100"
                                MinWidth="100"
                                MaxWidth="150"
                                Width="Auto"
                                StepFrequency="5"/>
                            <TextBlock
                                Text="{x:Bind ViewModel.MatchThreshold, Mode=OneWay}"
                                Width="40"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Auto Scraping -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="自动刮削" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="添加新游戏时自动刮削元数据"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            IsOn="{x:Bind ViewModel.AutoScrapeOnAdd, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <!-- Bangumi Login -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Bangumi 登录" FontWeight="SemiBold"/>
                        <TextBlock
                            Text="登录 Bangumi 以获得更好的刮削结果"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="OAuth 登录" Click="OnBangumiLoginClick"/>
                            <Button Content="输入 API 密钥" Click="OnBangumiApiKeyClick"/>
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.BangumiUserId, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource SystemAccentColor}"
                            Visibility="{x:Bind ViewModel.BangumiUserId, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- ==================== Launch Behavior ==================== -->
                <TextBlock
                    Text="启动行为"
                    Style="{StaticResource SettingsSectionHeaderStyle}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="启动游戏时" FontWeight="SemiBold"/>
                        <TextBlock
                            Text="启动游戏时应用的行为"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ComboBox
                            SelectedIndex="{x:Bind ViewModel.OnLaunchBehavior, Converter={StaticResource LaunchBehaviorConverter}, Mode=TwoWay}"
                            MinWidth="150"
                            MaxWidth="250"
                            Width="Auto"
                            HorizontalAlignment="Left">
                            <ComboBoxItem Content="无操作"/>
                            <ComboBoxItem Content="最小化"/>
                            <ComboBoxItem Content="最小化到托盘"/>
                            <ComboBoxItem Content="退出应用"/>
                        </ComboBox>
                        <!-- Warning for Exit App -->
                        <InfoBar
                            Title="警告"
                            Message="{x:Bind ViewModel.LaunchBehaviorWarning, Mode=OneWay}"
                            Severity="Warning"
                            IsOpen="{x:Bind ViewModel.LaunchBehaviorWarning, Mode=OneWay, Converter={StaticResource EmptyStringToBooleanConverter}}"
                            Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ==================== Exit Behavior ==================== -->
                <TextBlock
                    Text="退出行为"
                    Style="{StaticResource SettingsSectionHeaderStyle}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="游戏退出时" FontWeight="SemiBold"/>
                        <TextBlock
                            Text="游戏进程退出后应用的行为"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ComboBox
                            SelectedIndex="{x:Bind ViewModel.OnExitBehavior, Converter={StaticResource ExitBehaviorConverter}, Mode=TwoWay}"
                            MinWidth="150"
                            MaxWidth="250"
                            Width="Auto"
                            HorizontalAlignment="Left">
                            <ComboBoxItem Content="恢复到桌面"/>
                            <ComboBoxItem Content="保持在托盘"/>
                            <ComboBoxItem Content="最小化"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="退出时自动备份" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="游戏退出时自动备份存档"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            IsOn="{x:Bind ViewModel.AutoBackupOnExit, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <!-- ==================== Boss Key Settings ==================== -->
                <TextBlock
                    Text="老板键设置"
                    Style="{StaticResource SettingsSectionHeaderStyle}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="启用老板键" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="使用热键快速隐藏所有游戏窗口"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            IsOn="{x:Bind ViewModel.EnableBossKey, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="老板键组合" FontWeight="SemiBold"/>
                        <TextBlock
                            Text="设置老板键热键组合"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <!-- Modifier Keys -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <CheckBox Content="Ctrl" IsChecked="{x:Bind ViewModel.BossKeyCtrl, Mode=TwoWay}"/>
                            <CheckBox Content="Alt" IsChecked="{x:Bind ViewModel.BossKeyAlt, Mode=TwoWay}"/>
                            <CheckBox Content="Shift" IsChecked="{x:Bind ViewModel.BossKeyShift, Mode=TwoWay}"/>
                            <CheckBox Content="Win" IsChecked="{x:Bind ViewModel.BossKeyWin, Mode=TwoWay}"/>
                        </StackPanel>

                        <!-- Key Selection -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <TextBlock Text="键：" VerticalAlignment="Center"/>
                            <ComboBox
                                SelectedItem="{x:Bind ViewModel.BossKeyKey, Mode=TwoWay}"
                                MinWidth="60"
                                MaxWidth="100"
                                Width="Auto"
                                HorizontalAlignment="Left">
                                <x:String>A</x:String>
                                <x:String>B</x:String>
                                <x:String>C</x:String>
                                <x:String>D</x:String>
                                <x:String>E</x:String>
                                <x:String>F</x:String>
                                <x:String>G</x:String>
                                <x:String>H</x:String>
                                <x:String>I</x:String>
                                <x:String>J</x:String>
                                <x:String>K</x:String>
                                <x:String>L</x:String>
                                <x:String>M</x:String>
                                <x:String>N</x:String>
                                <x:String>O</x:String>
                                <x:String>P</x:String>
                                <x:String>Q</x:String>
                                <x:String>R</x:String>
                                <x:String>S</x:String>
                                <x:String>T</x:String>
                                <x:String>U</x:String>
                                <x:String>V</x:String>
                                <x:String>W</x:String>
                                <x:String>X</x:String>
                                <x:String>Y</x:String>
                                <x:String>Z</x:String>
                                <x:String>Space</x:String>
                                <x:String>Esc</x:String>
                            </ComboBox>
                        </StackPanel>

                        <!-- Current Hotkey Display -->
                        <TextBlock
                            Text="{x:Bind ViewModel.BossKeyDisplay, Mode=OneWay}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemAccentColor}"
                            Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="最小化到托盘" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="激活老板键时最小化应用到系统托盘"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            IsOn="{x:Bind ViewModel.MinimizeToTrayOnBossKey, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="显示通知" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="激活老板键时显示通知"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            IsOn="{x:Bind ViewModel.ShowBossKeyNotification, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <!-- ==================== Save Path Settings ==================== -->
                <TextBlock
                    Text="存档路径设置"
                    Style="{StaticResource SettingsSectionHeaderStyle}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="使用自定义备份路径" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="使用自定义路径而不是默认应用数据文件夹"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            IsOn="{x:Bind ViewModel.UseCustomBackupPath, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <Border
                    Style="{StaticResource SettingsCardStyle}"
                    Visibility="{x:Bind ViewModel.UseCustomBackupPath, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="备份存储路径" FontWeight="SemiBold"/>
                        <TextBlock
                            Text="{x:Bind ViewModel.DefaultBackupPath, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"/>
                        <Button
                            Content="选择文件夹"
                            Click="OnSelectBackupPathClick"
                            Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="默认备份路径（应用数据）" FontWeight="SemiBold"/>
                        <TextBlock
                            Text="{x:Bind ViewModel.AppDataPath, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource SystemAccentColor}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap"/>
                        <Button
                            Content="打开数据文件夹"
                            Command="{x:Bind ViewModel.OpenDataFolderCommand}"
                            Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ==================== Process Monitoring ==================== -->
                <TextBlock
                    Text="进程监控"
                    Style="{StaticResource SettingsSectionHeaderStyle}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="高级监控" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="启用运行游戏的 CPU/内存/GPU 跟踪"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            IsOn="{x:Bind ViewModel.EnableAdvancedMonitoring, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="退出时自动截图" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="游戏退出时自动截取屏幕截图"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            IsOn="{x:Bind ViewModel.AutoScreenshotOnExit, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="监控间隔" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="检查进程状态的频率（毫秒）"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBox
                                Text="{x:Bind ViewModel.MonitoringIntervalMs, Mode=TwoWay}"
                                MinWidth="60"
                                MaxWidth="100"
                                Width="Auto"
                                InputScope="Number"/>
                            <TextBlock Text="ms" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="截图格式" FontWeight="SemiBold"/>
                        <TextBlock
                            Text="截取截图的格式"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ComboBox
                            SelectedIndex="{x:Bind ViewModel.ScreenshotFormat, Converter={StaticResource ScreenshotFormatConverter}, Mode=TwoWay}"
                            MinWidth="80"
                            MaxWidth="120"
                            Width="Auto"
                            HorizontalAlignment="Left">
                            <ComboBoxItem Content="PNG"/>
                            <ComboBoxItem Content="JPG"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border
                    Style="{StaticResource SettingsCardStyle}"
                    Visibility="{x:Bind ViewModel.ScreenshotFormat, Mode=OneWay, Converter={StaticResource SettingsScreenshotFormatToJpgVisibilityConverter}}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="JPG 质量" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="JPG 截图的质量等级（1-100）"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Slider
                                Value="{x:Bind ViewModel.JpgQuality, Mode=TwoWay}"
                                Minimum="1"
                                Maximum="100"
                                MinWidth="80"
                                MaxWidth="120"
                                Width="Auto"
                                StepFrequency="5"/>
                            <TextBlock
                                Text="{x:Bind ViewModel.JpgQuality, Mode=OneWay}"
                                Width="30"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== Appearance ==================== -->
                <TextBlock
                    Text="外观"
                    Style="{StaticResource SettingsSectionHeaderStyle}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="主题" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="应用颜色主题"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            SelectedIndex="{x:Bind ViewModel.Theme, Converter={StaticResource AppThemeConverter}, Mode=TwoWay}"
                            MinWidth="120"
                            MaxWidth="180"
                            Width="Auto">
                            <ComboBoxItem Content="系统默认"/>
                            <ComboBoxItem Content="浅色"/>
                            <ComboBoxItem Content="深色"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="语言" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="应用显示语言"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            SelectedIndex="{x:Bind ViewModel.Language, Converter={StaticResource AppLanguageConverter}, Mode=TwoWay}"
                            MinWidth="120"
                            MaxWidth="180"
                            Width="Auto">
                            <ComboBoxItem Content="简体中文"/>
                            <ComboBoxItem Content="英文"/>
                            <ComboBoxItem Content="日文"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="游戏库视图模式" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="游戏库的默认视图模式"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            SelectedIndex="{x:Bind ViewModel.LibraryViewMode, Converter={StaticResource LibraryViewModeConverter}, Mode=TwoWay}"
                            MinWidth="120"
                            MaxWidth="180"
                            Width="Auto">
                            <ComboBoxItem Content="网格"/>
                            <ComboBoxItem Content="表格"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- ==================== Library Settings ==================== -->
                <TextBlock
                    Text="游戏库设置"
                    Style="{StaticResource SettingsSectionHeaderStyle}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="启动时自动扫描" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="应用启动时自动扫描新游戏"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            IsOn="{x:Bind ViewModel.AutoScanOnStartup, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="默认刮削来源" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="游戏信息的主要元数据来源"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="120"
                            MaxWidth="180"
                            Width="Auto"
                            SelectedIndex="{x:Bind ViewModel.DefaultScrapingSource, Mode=TwoWay, Converter={StaticResource DefaultScrapingSourceConverter}}">
                            <ComboBoxItem Content="Bangumi"/>
                            <ComboBoxItem Content="VNDB"/>
                            <ComboBoxItem Content="ymgal"/>
                            <ComboBoxItem Content="cngal"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Game Directories Management -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="游戏目录" FontWeight="SemiBold"/>
                                <TextBlock
                                    Text="管理扫描游戏时使用的目录列表"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Click="OnAddGameDirectoryClick"
                                Style="{StaticResource AccentButtonStyle}"
                                CornerRadius="8"
                                Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon FontSize="14" Glyph="&#xE710;"/>
                                    <TextBlock Text="添加目录"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Directory List -->
                        <ListView
                            ItemsSource="{x:Bind ViewModel.GameDirectories, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedDirectory, Mode=TwoWay}"
                            SelectionMode="Single"
                            Height="150"
                            Margin="0,8,0,0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12" Padding="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Grid.Column="0"
                                            FontSize="16"
                                            Glyph="&#xE8B7;"
                                            Foreground="{ThemeResource SystemAccentColor}"/>
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding}"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"/>
                                        <Button
                                            Grid.Column="2"
                                            Click="OnRemoveGameDirectoryClick"
                                            DataContext="{Binding}"
                                            Background="Transparent"
                                            Padding="8"
                                            ToolTipService.ToolTip="删除目录">
                                            <FontIcon FontSize="12" Glyph="&#xE74D;" Foreground="{ThemeResource SystemErrorTextColor}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty State -->
                        <StackPanel
                            Visibility="{x:Bind ViewModel.GameDirectories.Count, Mode=OneWay, Converter={StaticResource InverseCountToVisibilityConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="24"
                            Spacing="8">
                            <FontIcon FontSize="32" Glyph="&#xE8B7;" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock
                                Text="没有设置游戏目录"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"/>
                            <TextBlock
                                Text="点击上方按钮添加游戏目录"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================== About ==================== -->
                <TextBlock
                    Text="关于"
                    Style="{StaticResource SettingsSectionHeaderStyle}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Galbox" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock
                            Text="{x:Bind ViewModel.AppVersion, Mode=OneWay, Converter={StaticResource SettingsVersionTextConverter}}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock
                            Text="一款用于视觉小说和 Galgame 的游戏库管理器。"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock
                            Text="{x:Bind ViewModel.DeveloperInfo, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock
                            Text="{x:Bind ViewModel.LicenseInfo, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button
                            Content="在 GitHub 上查看"
                            Command="{x:Bind ViewModel.OpenGitHubCommand}"
                            Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Database Info -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="数据库位置" FontWeight="SemiBold"/>
                        <TextBlock
                            Text="游戏数据存储位置"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock
                            Text="{x:Bind ViewModel.AppDataPath, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource SystemAccentColor}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>