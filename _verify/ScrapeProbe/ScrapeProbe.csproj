<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ScrapeProbe - minimal runnable verification harness for the Galbox metadata scraping link.

    It is intentionally NOT part of Galbox.sln (a sibling agent owns tests\\Galbox.Acceptance\\)
    and it does not re-implement any scraping logic: the Galbox.App service sources below are
    compile-included verbatim, so this program exercises the exact same code the app runs.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Galbox.Verify.ScrapeProbe</RootNamespace>
    <AssemblyName>ScrapeProbe</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS8618;CS8625</NoWarn>
    <!-- Keep the probe out of the app's build: it is a standalone console project. -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Galbox.Core\Galbox.Core.csproj" />
    <ProjectReference Include="..\..\src\Galbox.Data\Galbox.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real Galbox.App sources (these services have no WinUI dependency). -->
    <Compile Include="..\..\src\Galbox.App\Services\GameScrapingService.cs" Link="App\GameScrapingService.cs" />
    <Compile Include="..\..\src\Galbox.App\Services\IGameScrapingService.cs" Link="App\IGameScrapingService.cs" />
    <Compile Include="..\..\src\Galbox.App\Services\ScrapingCacheService.cs" Link="App\ScrapingCacheService.cs" />
    <Compile Include="..\..\src\Galbox.App\Services\ScrapingSettingsProvider.cs" Link="App\ScrapingSettingsProvider.cs" />
    <Compile Include="..\..\src\Galbox.App\Services\AutoScrapingService.cs" Link="App\AutoScrapingService.cs" />
    <Compile Include="..\..\src\Galbox.App\Services\IAutoScrapingService.cs" Link="App\IAutoScrapingService.cs" />
    <Compile Include="..\..\src\Galbox.App\Services\GameUtilityService.cs" Link="App\GameUtilityService.cs" />
    <Compile Include="..\..\src\Galbox.App\Services\IGameUtilityService.cs" Link="App\IGameUtilityService.cs" />
  </ItemGroup>

</Project>
